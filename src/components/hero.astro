---
import Icon from "../components/Icon.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils.js";

import BookButton from "./book-button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="grid md:grid-cols-2 md:p-6 mt-10">
  <div>
    <h1
      class="text-3xl lg:text-4xl xl:text-6xl font-bold lg:tracking-tight xl:tracking-tighter text-center md:pt-16 pb-5 md:pb-10">
      {i18n.HERO_H1_1}
    </h1>
    <BookButton />

    <div class="flex gap-3 m-auto">
      <a
        class="bg-[#ff5e00] grid justify-center content-center rounded-full size-12 hover:scale-110 duration-200 active:scale-90"
        href="https://wa.me/34665311314?text=Hello, welcome to Montaraz Outdoors and Culture! How can we help you?"
        target="_blank"><Icon icon="whatsap-logo" size="2rem" color="#fff" /></a
      >

      <a
        class="bg-[#ff5e00] grid justify-center content-center rounded-full size-12 hover:scale-110 duration-200"
        href="https://www.instagram.com/montaraz_outdoors_culture/"
        target="_blank"
        ><Icon icon="instagram-logo" size="2rem" color="#fff" /></a
      >

      <a
        class="bg-[#ff5e00] grid justify-center content-center rounded-full size-12 hover:scale-110 duration-200"
        href="mailto:montarazoutdoors@gmail.com"
        ><Icon icon="mail-logo" size="2rem" color="#fff" /></a
      >
      <a
        class="bg-[#ff5e00] grid justify-center content-center rounded-full size-12 hover:scale-110 duration-200"
        href="https://www.youtube.com/@montarazoutdoors"
        target="_blank"><Icon icon="youtube-logo" size="2rem" color="#fff" /></a
      >
    </div>
  </div>
  <div class="rotate-12 md:-mr-32">
    <img
      class="md:mt-10 mt-6 m-auto hidden md:block wobble-hor-bottom"
      src="/logo.svg"
      alt=""
    />
  </div>
</div>

<style>
  .wobble-hor-bottom {
    -webkit-animation: wobble-hor-bottom 7s infinite both;
    animation: wobble-hor-bottom 7s infinite both;
  }

  @-webkit-keyframes wobble-hor-bottom {
    0%,
    100% {
      -webkit-transform: translateX(0%);
      transform: translateX(0%);
      -webkit-transform-origin: 50% 50%;
      transform-origin: 50% 50%;
    }
    15% {
      -webkit-transform: translateX(-30px) rotate(-6deg);
      transform: translateX(-30px) rotate(-6deg);
    }
    30% {
      -webkit-transform: translateX(15px) rotate(6deg);
      transform: translateX(15px) rotate(6deg);
    }
    45% {
      -webkit-transform: translateX(-15px) rotate(-3.6deg);
      transform: translateX(-15px) rotate(-3.6deg);
    }
    60% {
      -webkit-transform: translateX(9px) rotate(2.4deg);
      transform: translateX(9px) rotate(2.4deg);
    }
    75% {
      -webkit-transform: translateX(-6px) rotate(-1.2deg);
      transform: translateX(-6px) rotate(-1.2deg);
    }
  }
  @keyframes wobble-hor-bottom {
    0%,
    100% {
      -webkit-transform: translateX(0%);
      transform: translateX(0%);
      -webkit-transform-origin: 50% 50%;
      transform-origin: 50% 50%;
    }
    15% {
      -webkit-transform: translateX(-30px) rotate(-6deg);
      transform: translateX(-30px) rotate(-6deg);
    }
    30% {
      -webkit-transform: translateX(15px) rotate(6deg);
      transform: translateX(15px) rotate(6deg);
    }
    45% {
      -webkit-transform: translateX(-15px) rotate(-3.6deg);
      transform: translateX(-15px) rotate(-3.6deg);
    }
    60% {
      -webkit-transform: translateX(9px) rotate(2.4deg);
      transform: translateX(9px) rotate(2.4deg);
    }
    75% {
      -webkit-transform: translateX(-6px) rotate(-1.2deg);
      transform: translateX(-6px) rotate(-1.2deg);
    }
  }
</style>
