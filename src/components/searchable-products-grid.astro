---
import ProductCard from "./product-card.astro";

interface Product {
  title: string;
  href: string;
  image: string;
  alt?: string;
}

interface Props {
  products: Product[];
  columns?: string;
}

const { products, columns = "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" } =
  Astro.props;
const inputId = "search-input";
const gridId = "search-grid";
const noResultsId = "search-empty";
---

<div class="space-y-4">
  <div class="max-w-xl">
    <label
      for={inputId}
      class="block text-sm font-semibold text-slate-700 mb-2">
      Search products
    </label>
    <input
      id={inputId}
      type="search"
      placeholder="Type a product name..."
      class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-[#3c5546] focus:ring-2 focus:ring-[#3c5546]/20"
    />
  </div>

  <p id={noResultsId} class="hidden text-sm text-slate-600">
    No products found.
  </p>

  <div id={gridId} class={`grid gap-6 ${columns}`}>
    {
      products.map((product) => (
        <div data-title={product.title.toLowerCase()}>
          <ProductCard {...product} />
        </div>
      ))
    }
  </div>
</div>

<script is:inline type="module">
  const input = document.getElementById("search-input");
  const grid = document.getElementById("search-grid");
  const empty = document.getElementById("search-empty");

  if (input && grid && empty) {
    const cards = Array.from(grid.querySelectorAll("[data-title]"));

    input.addEventListener("input", (event) => {
      const value = event.target.value.trim().toLowerCase();
      let found = false;

      cards.forEach((card) => {
        const title = card.dataset.title || "";
        const matches = value === "" || title.includes(value);
        card.style.display = matches ? "" : "none";
        if (matches) found = true;
      });

      empty.classList.toggle("hidden", found);
    });
  }
</script>
