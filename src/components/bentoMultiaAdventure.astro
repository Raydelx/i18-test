---
import BentoItem from "../components/bentoItem.astro";
import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);

const translatePath = useTranslatedPath(lang);
---

<section
  class={`
    mx-auto grid w-full max-w-[1400px] grid-cols-1 auto-rows-[20rem] gap-4
    sm:grid-cols-2 sm:auto-rows-[21rem] lg:grid-cols-10 lg:auto-rows-[22rem] md:p-10
  `}>
  <BentoItem
    class="col-span-1 sm:col-span-2 lg:col-span-5"
    title="Rock Climbing"
    href={translatePath("/rock-climbing-products/")}>
    <div
      slot="image"
      class="absolute inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-105"
      style="background-image: url('/multi-adventure/rock-climbing.webp')">
    </div>
  </BentoItem>

  <BentoItem
    class="col-span-1 sm:col-span-2 lg:col-span-5"
    title="Via Ferrata"
    href="#">
    <div
      slot="image"
      class="absolute inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-105"
      style="background-image: url('/multi-adventure/via-ferrata.webp')">
    </div>
  </BentoItem>
</section>
