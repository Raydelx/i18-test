---
import NewFaq from "@/components/newFaq.astro";
import Container from "@/components/container.astro";
import faqs from "@/data_files/faqs.json";
import Layout from "@/layouts/Layout.astro";
import CardHome from "@/components/cardHome.astro";
import Gallery from "@/components/gallery.astro";
import Hero from "@/components/hero.astro";
import Card from "../../components/card.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

import WelcomeCard from "../welcome-card.astro";
import InfiniteCarousel from "../InfiniteCarousel.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const ROADBIKEPRODUCTS = [
  {
    name: "Granada E-Bike Tour 8 Days",
    description:
      "One journey, endless landscapes — the ultimate e-bike adventure around Granada.",
    description2: "",
    href: translatePath("cycle-tour-granada"),
    href_img: "/home/granada-ebike.webp",
    alt_img: "string",
  },
  {
    name: "Ronda - Córdoba E-Bike Tour 8 Days",
    description:
      "Discover the heart of Andalusia by bike, from the dramatic cliffs of Ronda to the Moorish beauty of Córdoba.  ",
    description2: "",
    href: translatePath("cycle-ronda-cordoba"),
    href_img: "/home/ronda-cordoba.webp",
    alt_img: "string",
  },
  {
    name: "Custom-Made Andalusia Trips",
    description:
      "Personalized journeys through Andalusia, designed just for you.",
    description2: "",
    href: translatePath("tailor-made-travel"),
    href_img: "/home/custom-made.webp",
    alt_img: "string",
  },
  {
    name: "Sierra Nevada E-MTB Tour 8 Days",
    description:
      " Explore the majestic Sierra Nevada mountains on an unforgettable e-bike adventure.",
    description2: "",
    href: translatePath("sierra-nevada-e-mtb-tour-8-days"),
    href_img:
      "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-principal.webp",
    alt_img: "Sierra Nevada E-BikeTour 8 Days",
  },
];
---

<Layout title="">
  <section class="w-full overflow-hidden bg-black">
    <video
      class="block h-[350px] w-full object-cover md:h-[85vh]"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      width="1280"
      height="720"
      aria-hidden="true">
      <source src="/video/vid-hor-indez.webm" type="video/webm" />
    </video>
  </section>

  <section class="mb-10 md:mb-28 lg:px-40 px-4">
    <Hero />
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 md:px-8">
    <div
      class="overflow-hidden rounded-lg border-4 border-[#ff5e00] bg-black shadow-lg">
      <button
        class="group relative block aspect-video w-full overflow-hidden"
        type="button"
        data-youtube-poster
        aria-label="Play Montaraz Outdoors video">
        <img
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          src="/video/thumbnail.png"
          alt="Montaraz Outdoors video preview"
          width="1280"
          height="720"
          loading="lazy"
        />
        <span
          class="absolute inset-0 bg-black/20 transition-colors duration-300 group-hover:bg-black/35"
        ></span>
        <span
          class="absolute left-1/2 top-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-red-600 text-white shadow-lg transition-transform duration-300 group-hover:scale-110"
          aria-hidden="true">
          <svg viewBox="0 0 24 24" class="ml-1 size-8 fill-current"
            ><path d="M8 5v14l11-7z"></path></svg
          >
        </span>
      </button>
      <iframe
        class="hidden aspect-video w-full"
        data-youtube-player
        title="Montaraz Outdoors video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </section>

  <script>
    const poster = document.querySelector<HTMLButtonElement>(
      "[data-youtube-poster]",
    );
    const player = document.querySelector<HTMLIFrameElement>(
      "[data-youtube-player]",
    );

    poster?.addEventListener("click", () => {
      if (!player) return;

      player.src =
        "https://www.youtube-nocookie.com/embed/YpukuwdUOhI?autoplay=1&controls=1&rel=0&modestbranding=1";
      poster.remove();
      player.classList.remove("hidden");
    });
  </script>

  <section class="lg:mt-26 mt-12"><WelcomeCard /></section>

  <Container class="w-full">
    <section>
      <CardHome />
    </section>

    <section class="mt-10 w-auto flex justify-center">
      <NewFaq title="What our clients<br />said about us?" faqs={faqs} />
    </section>

    <h2
      class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight">
      Exclusive Trips
    </h2>
    <main class="mt-10 md:mt-16">
      <InfiniteCarousel items={ROADBIKEPRODUCTS} speed={30} />
    </main>
  </Container>
</Layout>
