---
import Container from "../../../components/container.astro";
import InformationProducts from "../../../components/ui/informationProducts.astro";
import Icon from "../../../components/Icon.astro";
import Layout from "../../../layouts/Layout.astro";
import SliderReact from "../../../hooks/SliderReact";
import Days from "@/components/products-components/days.astro";
import Includes from "@/components/products-components/includes.astro";
import Route from "@/components/ui/icons/route.astro";
import Dots from "@/components/ui/dots.astro";
import Widget from "@/components/products-components/widget.astro";
import Cancellation from "@/components/products-components/cancellation.astro";

import { getI18N } from "@/i18n/";
import PricesTrekking from "@/components/products-components/prices-trekking.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// Duplica y cambia las rutas para añadir o modificar las fotos

const IMG = [
  {
    src: "/hiking-and-trekking/the-old-mine-trail/tomt-1.webp",
  },
  {
    src: "/hiking-and-trekking/the-old-mine-trail/tomt-2.webp",
  },
  {
    src: "/hiking-and-trekking/the-old-mine-trail/tomt-3.webp",
  },
  {
    src: "/hiking-and-trekking/the-old-mine-trail/tomt-4.webp",
  },
  {
    src: "/hiking-and-trekking/the-old-mine-trail/tomt-5.webp",
  },
];
const DAYS = [
  {
    day: i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DAY_1.TITLE,
    tecnicalInfo: true,
    description: i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DAY_1.TEXT_1,
    description2: i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DAY_1.TEXT_2,
    description3: i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DAY_1.TEXT_3,
    techical_optional: "First loop",
    totalDistance: "22 KM",
    totalAscent: "1000 M",
    totalDescent: "1000 M",
    duration: "7 hours",

    totalDistance2: "15 KM",
    totalAscent2: "800 M",
    totalDescent2: "800 M",
    duration2: "5 hours",
    physical_difficulty: "C",

    techical_optional2: "Second  loop",
    physical_difficulty2: "B+",
  },
];

const brings = [
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_2,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_3,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_4,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_5,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_6,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_7,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_8,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_9,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_10,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_11,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_12,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_13,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING_TEXT_14,
  },
];
---

<Layout title="">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-no-repeat bg-[url('/public/hiking-and-trekking/the-old-mine-trail/tomt-principal.webp')] h-[25rem] rounded-2xl bg-cover">
        <div class="flex flex-col justify-end h-full p-6 w-auto bg-cover">
          <div class="flex gap-2 [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.LOCATION}
            </p>
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.TITLE}
          </h1>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.PRICE}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
            .PRE_BOOKING}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
            .MINUMUM_OF_PERSONS}>
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DURATION_1}
          subtitle3={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
            .DURATION_2}>
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.TOUR_TYPE}>
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.SEASON}>
          <!-- <div slot="icon">
            <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
          </div> -->
        </InformationProducts>
      </div>

      <!-- Informacion tecnica -->

      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .TOTAL_DISTANCE_1}
            subtitle3={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .TOTAL_DISTANCE_2}>
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .TOTAL_ASCENT_1}
            subtitle3={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .TOTAL_ASCENT_2}>
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DESCENT}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .TOTAL_DESCENT_1}
            subtitle3={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .TOTAL_DESCENT_2}>
            <div slot="icon">
              <Icon icon="down-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts title="Route type" subtitle="Loop Trail">
            <div slot="icon">
              <Route />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.PHYSICAL_DIFFICULTY}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .PHYSICAL_DIFFICULTY_1}
            subtitle3={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .PHYSICAL_DIFFICULTY_2}
          />
        </div>
      </div>

      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-3 mt-20 md:mt-26 md:mb-36 gap-16 md:gap-4">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.INCLUDED
            .TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.INCLUDED
                    .TEXT_1
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.INCLUDED
                    .TEXT_2
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.INCLUDED
                    .TEXT_3
                }
              </p>
            </li>
          </ul>
        </Includes>
        <!-- Exclude -->
        <Includes
          title={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.NOT_INCLUDED
            .TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.NOT_INCLUDED
                    .TEXT_1
                }
              </p>
            </li>
          </div>
        </Includes>
        <!-- Complementaries -->
      </div>
    </main>

    <div
      class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 md:py-36 py-10 items-center">
      <div class="static h-[385px] hidden md:block">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/hiking-and-trekking/the-old-mine-trail/tomt-1.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[12rem] md:mt-48 lg:mt-60 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/hiking-and-trekking/the-old-mine-trail/tomt-3.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/hiking-and-trekking/the-old-mine-trail/tomt-4.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5">
        <div class="grid grid-flow-row gap-4">
          <h2
            class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.AVAILABILITY}
          </h2>
          <div class="flex gap-2">
            <Icon icon="spring-logo" size="1.6rem" color="#0E46A3" />
            <p class="max-w-2xl text-gray-900 mb-2 md:px-0 text-xl md:text-xl">
              {
                i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
                  .AVAILABILITY_TEXT_1
              }
            </p>
          </div>
        </div>

        <div class="">
          <h2
            class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT}
          </h2>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT_TEXT_1}
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT_TEXT_2}
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT_TEXT_3}
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT_TEXT_4}
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT_TEXT_5}
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.HIGHLIGHT_TEXT_6}
          </p>
        </div>
      </div>
    </div>

    <Widget
      title={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_BRING}
      description={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
        .WHAT_TO_BRING_TEXT_1}
      img="/hiking-and-trekking/trekking-alpujarras/bring.webp"
      text={i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
        .WHAT_TO_BRING_TEXT_15}
      brings={brings}
    />

    <!-- Button to download PDF -->
    <section class="grid md:grid-cols-2 gap-10">
      <PricesTrekking />
      <Cancellation />

      <div>
        <h2 class="text-4xl md:text-4xl xl:text-4xl font-bold mb-6">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_1}
        </h2>
        <p class="text-gray-700 text-lg">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_2}
        </p>
        <p class="text-gray-700 text-lg">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_3}
        </p>
        <h2 class="text-4xl md:text-4xl xl:text-4xl font-bold mb-6 mt-8">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_4}
        </h2>
        <p class="text-gray-700 text-lg">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_5}
        </p>
        <p class="text-gray-700 text-lg">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_6}
        </p>
        <p class="text-gray-700 text-lg">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.DIFFICULTY_7}
        </p>
      </div>
      <div class="">
        <h2
          class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-4xl xl:text-4xl">
          {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.REQUIEREMENTS}
        </h2>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .REQUIEREMENTS_TEXT_1
          }
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .REQUIEREMENTS_TEXT_2
          }
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL
              .REQUIEREMENTS_TEXT_3
          }
        </p>
      </div>
    </section>

    <!-- Slider Photos -->
    <section class="m-auto md:w-full rounded-xl md:px-8 md:py-20">
      <ol class="relative mt-16">
        {(<SliderReact IMG={IMG} client:visible />)}
      </ol>
    </section>

    <!--  TimeLine per days  -->
    <h2 class="text-4xl md:text-5xl xl:text-6xl md:p-8 mt-16 font-bold mb-4">
      {i18n.PRODUCTS.HIKING_TREKKING.THE_OLD_MINE_TRAIL.WHAT_TO_EXPECT}
    </h2>
    {
      DAYS.map((tour) => (
        <ol class="mb-10">
          <Days {...tour} />
        </ol>
      ))
    }
  </Container>
</Layout>
