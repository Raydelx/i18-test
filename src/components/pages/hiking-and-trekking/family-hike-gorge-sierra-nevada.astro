          </p>
          <p class="text-gray-700 text-lg">
            {
              i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
                .PRICES_TEXT_2
            }
          </p>
        </div>
      </div>
      <Cancellation />
      <div class="">
        <h2
          class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
          {
            i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
              .REQUIEREMENTS
