  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_8,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_9,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_10,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
