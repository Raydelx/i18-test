---

<Layout title="">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-no-repeat bg-[url('/public/hiking-and-trekking/family-hike-gorge-of-sierra-nevada/fh-principal.webp')] h-[25rem] rounded-2xl bg-cover">
        <div class="flex flex-col justify-end h-full p-6 w-auto bg-cover">
          <div class="flex gap-2 [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            <Icon icon="destiny-logo" size="1.6rem" color="White" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              {
                i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
                  .LOCATION
              }
            </p>
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            {
              i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
                .TITLE
            }
          </h1>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING
            .FAMILY_HIKE_GORGE_SIERRA_NEVADA.PRICE}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING
            .FAMILY_HIKE_GORGE_SIERRA_NEVADA.PRE_BOOKING}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING
            .FAMILY_HIKE_GORGE_SIERRA_NEVADA.MINIMUM_OF_PERSONS}>
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING
            .FAMILY_HIKE_GORGE_SIERRA_NEVADA.DURATION}>
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING
            .FAMILY_HIKE_GORGE_SIERRA_NEVADA.TOUR_TYPE}>
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
