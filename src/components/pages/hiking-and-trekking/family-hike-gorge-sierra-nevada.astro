      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_5,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_6,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
