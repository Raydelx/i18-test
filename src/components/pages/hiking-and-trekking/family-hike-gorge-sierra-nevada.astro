          </p>
        </div>
      </div>
    </div>

    <Widget
      title={i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING}
      description={i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_1}
      img="/hiking-and-trekking/trekking-alpujarras/bring.webp"
      text={i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
        .WHAT_TO_BRING_TEXT_12}
      brings={brings}
    />

    <!-- Button to download PDF -->
    <section class="grid md:grid-cols-2 gap-10">
      <div>
        <div class="flex flex-col gap-2 md:p-4">
          <div>
            <h3 class="text-4xl md:text-5xl xl:text-6xl font-bold">
              {
                i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
                  .PRICES
              }
            </h3>
          </div>
          <p class="text-gray-700 text-lg">
            {
              i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
                .PRICES_TEXT_1
