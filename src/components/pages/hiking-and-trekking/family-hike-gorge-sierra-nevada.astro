        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
              .REQUIEREMENTS_TEXT_1
