        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.FAMILY_HIKE_GORGE_SIERRA_NEVADA
              .REQUIEREMENTS_TEXT_3
