---
import Container from "../../../components/container.astro";
import InformationProducts from "../../../components/ui/informationProducts.astro";
import Icon from "../../../components/Icon.astro";
import Layout from "../../../layouts/Layout.astro";
import SliderReact from "../../../hooks/SliderReact";
import Days from "@/components/products-components/days.astro";
import Includes from "@/components/products-components/includes.astro";
import Route from "@/components/ui/icons/route.astro";
import Link from "@/components/ui/link.astro";
import Cancellation from "@/components/products-components/cancellation.astro";
import Widget from "@/components/products-components/widget.astro";
import Dots from "@/components/ui/dots.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// Duplica y cambia las rutas para añadir o modificar las fotos

const IMG = [
  {
    src: "/hiking-and-trekking/king-of-the-mountain/kom-1.webp",
  },
  {
    src: "/hiking-and-trekking/king-of-the-mountain/kom-2.webp",
  },
  {
    src: "/hiking-and-trekking/king-of-the-mountain/kom-3.webp",
  },
  {
    src: "/hiking-and-trekking/king-of-the-mountain/kom-4.webp",
  },
  {
    src: "/hiking-and-trekking/king-of-the-mountain/kom-5.webp",
  },
];
const DAYS = [
  {
    day: i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.DAY_1.TITLE,
    tecnicalInfo: true,
    description:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.DAY_1.TEXT_1,
    optional1:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.DAY_1.TEXT_2,
    totalDistance: "11 km",
    totalAscent: "750 m",
    totalDescent: "750 m",
    duration: "4 hours",
  },
];

const brings = [
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_2,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_3,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_4,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_5,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_6,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_7,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_8,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_9,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_10,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_11,
  },
  {
    title:
      i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
        .WHAT_TO_BRING_TEXT_12,
  },
];
---

<Layout title="">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-no-repeat bg-[url('/public/hiking-and-trekking/king-of-the-mountain/kom-product.webp')] h-[25rem] rounded-2xl bg-cover">
        <div class="flex flex-col justify-end h-full p-6 w-auto">
          <div class="flex gap-2">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              {i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.LOCATION}
            </p>
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            {i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.TITLE}
          </h1>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .PRICE}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .PRE_BOOKING}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .MINIMUM_OF_PERSONS}>
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .DURATION}>
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .TOUR_TYPE}>
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .SEASON}>
          <!-- <div slot="icon">
            <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
          </div> -->
        </InformationProducts>
      </div>

      <!-- Informacion tecnica -->

      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .TOTAL_DISTANCE}>
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .TOTAL_ASCENT}>
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DESCENT}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .TOTAL_DESCENT}>
            <div slot="icon">
              <Icon icon="down-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.ROUTE_TYPE}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .ROUTE_TYPE}>
            <div slot="icon">
              <Route />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.PHYSICAL_DIFFICULTY}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .PHYSICAL_DIFFICULTY}
          />
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TECHNICAL_DIFFICULTY}
            subtitle={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .TECHNICAL_DIFFICULTY}
          />
        </div>
      </div>

      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-3 mt-20 md:mt-26 md:mb-36 gap-16 md:gap-4">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .INCLUDED.TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .INCLUDED.TEXT_1
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .INCLUDED.TEXT_2
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .INCLUDED.TEXT_3
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .INCLUDED.TEXT_4
                }
              </p>
            </li>
          </ul>
        </Includes>
        <!-- Exclude -->
        <Includes
          title={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
            .NOT_INCLUDED.TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .NOT_INCLUDED.TEXT_1
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .NOT_INCLUDED.TEXT_2
                }
              </p>
            </li>
          </div>
        </Includes>
        <!-- Complementaries -->
        <Includes
          title={i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.EXTRA
            .TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex gap-2">
              <Icon icon="complement-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.EXTRA
                    .TEXT_1
                }
              </p>
            </li>
          </div>
        </Includes>
      </div>
    </main>

    <div class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 md:py-36 py-10">
      <div class="static h-[385px] hidden md:block">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/hiking-and-trekking/family-hike-gorge-of-sierra-nevada/fh-3.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[12rem] md:mt-48 lg:mt-60 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/hiking-and-trekking/family-hike-gorge-of-sierra-nevada/fh-4.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/hiking-and-trekking/family-hike-gorge-of-sierra-nevada/fh-2.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5">
        <div class="">
          <h2
            class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .AVAILABILITY
            }
          </h2>

          <ul class="grid gap-2 text-lg">
            <li class="flex flex-wrap gap-2">
              <Icon icon="spring-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .AVAILABILITY_SPRING
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .AVAILABILITY_AUTUMN
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="winter-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                    .AVAILABILITY_WINTER
                }
              </p>
            </li>
          </ul>
        </div>

        <div class="">
          <h2
            class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.HIGHLIGHT}
          </h2>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .HIGHLIGHT_TEXT_1
            }
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .HIGHLIGHT_TEXT_2
            }
          </p>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .HIGHLIGHT_TEXT_3
            }
          </p>
        </div>
        <div class="flex flex-col gap-2 md:p-4">
          <div>
            <h3 class="text-4xl md:text-5xl xl:text-6xl font-bold">
              {i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.PRICES}
            </h3>
            <Dots class="mb-4" />
          </div>
          <p class="text-gray-700">
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .PRICES_TEXT_1
            }
          </p>
          <p class="text-gray-700">
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .PRICES_TEXT_2
            }
          </p>
          <p class="text-gray-700">
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .PRICES_TEXT_3
            }
          </p>
          <p class="text-gray-700">
            {
              i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
                .PRICES_TEXT_4
            }
          </p>
        </div>
      </div>
    </div>

    <Widget
      title="What to bring for Hiking"
      description="Weather is important to consider while packing for your outdoor activity. Your packing list is based on your comfort and sensitivity. Layering your clothes is the best way to travel and be outdoors. It is highly recommended as the best way to stay warm and cool, as the weather is bound to change in the mountains."
      img="/hiking-and-trekking/trekking-alpujarras/bring.webp"
      text="Any questions about the recommendations of the material do not hesitate to contact us."
      brings={brings}
    />

    <!-- Button to download PDF -->
    <section class="grid md:grid-cols-2 gap-10">
      <div class="">
        <h2
          class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
          {
            i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .REQUIEREMENTS
          }
        </h2>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .REQUIEREMENTS_TEXT_1
          }
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .REQUIEREMENTS_TEXT_2
          }
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS
              .REQUIEREMENTS_TEXT_3
          }
        </p>
      </div>
      <Cancellation />
    </section>

    <!-- Slider Photos -->
    <section class="m-auto md:w-full rounded-xl md:px-8 md:py-20">
      <ol class="relative mt-16">
        {(<SliderReact IMG={IMG} client:visible />)}
      </ol>
    </section>

    <!--  TimeLine per days  -->
    <h2 class="text-4xl md:text-5xl xl:text-6xl md:p-8 mt-16 font-bold mb-4">
      {i18n.PRODUCTS.HIKING_TREKKING.KING_OF_THE_LOW_MOUNTAINS.WHAT_TO_EXPECT}
    </h2>
    {
      DAYS.map((tour) => (
        <ol class="mb-10">
          <Days {...tour} />
        </ol>
      ))
    }
  </Container>
</Layout>
