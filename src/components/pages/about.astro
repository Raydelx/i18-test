---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import AboutHero from "@/components/about-components/aboutHero.astro";
import AboutHeroIzq from "@/components/about-components/aboutHeroIzq.astro";
import Team from "@/components/team.astro";
import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<Layout title="About">
  <Container>
    <Sectionhead class="mb-6">
      <Fragment slot="title">{i18n.ABOUT.ABOUT}</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <div
      class="bg-no-repeat bg-cover bg-[url('/photos_about/principal.webp')] bg-center h-[16rem] md:h-[40rem] mt-10 rounded-xl">
    </div>
    <img class="size-56 md:mt-10 mt-6 m-auto" src="/logo.svg" alt="" />
    <div class="grid place-items-center md:mb-24 md:mt-10 mb-12 mt-8">
      <h2
        class="max-w-2xl text-3xl font-bold e tracking-tight leading-none md:text-4xl xl:text-5xl">
        {i18n.ABOUT.TITLE}
      </h2>
      <h2
        class="max-w-2xl mb-4 text-3xl t font-bold tracking-tight leading-none md:text-4xl xl:text-15xl">
        {i18n.ABOUT.TITLE_1}
      </h2>
      <p
        class="max-w-2xl font-medium t md:text-lg lg:text-xl text-center text-gray-500">
        {i18n.ABOUT.SUBTITLE}
      </p>
    </div>
  </Container>

  <Container>
    <div
      class="m-auto grid lg:grid w-full lg:grid-flow-col-dense lg:grid-cols-3 lg:gap-0 bg-center bg-no-repeat bg-[url('/public/bg_montaraz.jpg')] bg-cover min-h-[400px] lg:min-h-full">
      <div
        class="sm:mt-2 lg:mt-0 lg:order-none flex justify-center items-center col-span-3 md:col-span-2">
        <div
          class="md:max-w-sm lg:max-w-none lg:h-full lg:px-0 flex justify-center">
          <img
            loading="lazy"
            class="object-cover h-60 w-[1000px] md:w-80 md:h-60 lg:h-full lg:w-full"
            style="color:transparent"
            src="/andalucia.webp"
            alt="andalucia"
          />
        </div>
      </div>
      <div
        class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 col-span-3 lg:px-10 p-4 flex flex-col justify-center h-full overflow-y-auto max-h-[60vh] lg:max-h-none">
        <div class="p-6 flex flex-col justify-center h-full">
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p
              class="max-w-2xl mb-4 text-2xl t font-bold tracking-tight leading-none md:text-3xl text-white italic m-auto">
              {i18n.ABOUT.HERO_1}
            </p>
          </div>
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p class="max-w-2xl text-xl text-white italic m-auto">
              {i18n.ABOUT.HERO_1_1}
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
  <Container>
    <div
      class="m-auto grid lg:grid w-full lg:grid-flow-col-dense lg:grid-cols-3 lg:gap-0 bg-center bg-no-repeat bg-[url('/public/bg_montaraz.jpg')] bg-cover">
      <div
        class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-10 p-4 flex flex-col justify-center h-full col-start-1 col-span-1">
        <div class="p-6 flex flex-col justify-center h-full">
          <div
            class="mt-6 flex flex-col justify-center items-center text-center">
            <p
              class="max-w-2xl mb-4 text-2xl t font-bold tracking-tight leading-none md:text-3xl text-white italic m-auto">
              {i18n.ABOUT.HERO_5}
            </p>
          </div>
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p class="max-w-2xl text-xl text-white italic m-auto">
              {i18n.ABOUT.HERO_5_1}
            </p>
          </div>
        </div>
      </div>
      <div
        class="sm:mt-2 lg:mt-0 justify-center items-center lg:col-start-2 col-span-3 md:col-span-2">
        <div
          class="w-full md:max-w-sm lg:max-w-none lg:h-full lg:px-0 justify-center">
          <img
            loading="lazy"
            class="object-cover w-full h-60 sm:w-full sm:h-48 md:w-80 md:h-60 lg:h-full lg:w-full"
            style="color:transparent"
            src="/local-experts-guides.webp"
            alt="guias"
          />
        </div>
      </div>
    </div>
  </Container>

  <Container>
    <div
      class="m-auto grid lg:grid w-full lg:grid-flow-col-dense lg:grid-cols-3 lg:gap-0 bg-center bg-no-repeat bg-[url('/public/bg_montaraz.jpg')] bg-cover">
      <div
        class="sm:mt-2 lg:mt-0 lg:order-none flex justify-center items-center col-span-3 md:col-span-2">
        <div
          class="relative w-full md:max-w-sm lg:max-w-none lg:h-full lg:px-0 flex justify-center">
          <img
            loading="lazy"
            class="object-cover w-full h-60 sm:w-full sm:h-48 md:w-80 md:h-60 lg:h-full lg:w-full"
            style="color:transparent"
            src="/small-groups.webp"
            alt="small groups"
          />
        </div>
      </div>
      <div
        class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 col-span-3 lg:px-10 p-4 flex flex-col justify-center h-full">
        <div class="p-6 flex flex-col justify-center h-full">
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p
              class="max-w-2xl mb-4 text-2xl t font-bold tracking-tight leading-none md:text-3xl text-white italic m-auto">
              {i18n.ABOUT.HERO_7}
            </p>
          </div>
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p class="max-w-2xl text-xl text-white italic m-auto">
              {i18n.ABOUT.HERO_7_1}
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
  <Container>
    <div
      class="m-auto grid lg:grid w-full lg:grid-flow-col-dense lg:gap-0 bg-center bg-no-repeat bg-[url('/public/bg_montaraz.jpg')] bg-cover rounded-2xl mt-8">
      <div
        class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-10 p-4 flex flex-col justify-center h-full">
        <div class="p-6 flex flex-col justify-center h-full">
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p
              class="max-w-2xl mb-4 text-2xl t font-bold tracking-tight leading-none md:text-3xl text-white italic m-auto">
              {i18n.ABOUT.HERO_2}
            </p>
          </div>
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p class="max-w-2xl text-xl text-white italic m-auto">
              {i18n.ABOUT.HERO_2_1}
            </p>
          </div>
        </div>
      </div>
      <div
        class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-10 p-4 flex flex-col justify-center h-full">
        <div class="p-6 flex flex-col justify-center h-full">
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p
              class="max-w-2xl mb-4 text-2xl t font-bold tracking-tight leading-none md:text-3xl text-white italic m-auto">
              {i18n.ABOUT.HERO_4}
            </p>
          </div>
          <div
            class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
            <p class="max-w-2xl text-xl text-white italic m-auto">
              {i18n.ABOUT.HERO_4_1}
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <div class="grid place-items-center md:mt-24 mt-10">
    <h2
      class="max-w-2xl text-2xl font-bold tracking-tight leading-none md:text-4xl lg:text-5xl mb-4">
      {i18n.ABOUT.TEAM}
    </h2>
  </div>
  <Team />
</Layout>
