---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import Card from "../../components/card.astro";

import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const GRAVELKBIKE = [
  {
    name: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.TITLE,
    description: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.SUBTITLE,
    href: translatePath("sierra-nevada"),
    href_img: "/cycle-tour/montainbike/sierra-nevada/sn-product.webp",
    alt_img: "Sierra nevada tour with e-bike",
  },
  {
    name: "Sierra Nevada Desert  E-MTB Tour | 1 Day",
    description: "Wild Landscapes & Desert Scenery",
    href: translatePath("sierra-nevada-desert"),
    href_img: "/cycle-tour/montainbike/sierra-nevada-desert/snd-product.webp",
    alt_img: "Sierra nevada tour with e-bike",
  },
  {
    name: " Sierra Nevada E-MTBTour | 8 Days",
    description: "Mountain Trails, Remote Villages & Andalusian Adventure",
    href: translatePath("sierra-nevada-e-mtb-tour-8-days"),
    href_img:
      "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-product.webp",
    alt_img: "Sierra nevada tour with e-bike",
  },
  {
    name: "Gravel Adventure South Spain | 8 Days",
    description: "Remote Tracks, Open Landscapes & Authentic Andalusia",
    badge: "NEW",
    href: "#",
    href_img:
      "/cycle-tour/montainbike/gravel-adventure-south-spain/gass-product.webp",
    alt_img: "Sierra nevada tour with e-bike",
  },
];
---

<Layout title="Gravel Bike / MTB Products">
  <Container>
    <Sectionhead>
      <Fragment slot="title">MTB</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <main class="mt-32">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-12 w-full">
        {
          GRAVELKBIKE.map((tour) => (
            <li class="mb-10">
              <Card {...tour} />
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
