---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import {
  getLangFromUrl,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const { currentLocale } = Astro;
const translatePath = useTranslatedPath(lang);
const i18n = getI18N({ currentLocale });
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">{i18n.TOUR_DESTINATIONS}</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      <a
        href={translatePath("leisure-cycling-portugal")}
        class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#3c5546]/10 bg-white shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ff5e00]">
        <div
          class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#f3f5f2] to-[#e9eee9] p-6">
          <img
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            src="/destinations/portugal.png"
            alt="Portugal map"
            loading="lazy"
          />
          <span
            class="absolute left-5 top-5 h-1 w-10 rounded-full bg-[#ff5e00]">
          </span>
        </div>
        <div
          class="flex flex-1 items-center justify-between gap-4 bg-[#3c5546] px-5 py-5 text-white transition-colors group-hover:bg-[#304538]">
          <span class="text-xl font-bold sm:text-2xl">Portugal</span>
          <svg
            class="h-6 w-6 shrink-0 text-[#ff5e00] transition-transform duration-300 group-hover:translate-x-1.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </div>
      </a>

      <a
        href={translatePath("leisure-cycling-andalucia")}
        class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#3c5546]/10 bg-white shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ff5e00]">
        <div
          class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#f3f5f2] to-[#e9eee9] p-6">
          <img
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            src="/destinations/andalucia.webp"
            alt="Andalusia map"
            loading="lazy"
          />
          <span
            class="absolute left-5 top-5 h-1 w-10 rounded-full bg-[#ff5e00]">
          </span>
        </div>
        <div
          class="flex flex-1 items-center justify-between gap-4 bg-[#3c5546] px-5 py-5 text-white transition-colors group-hover:bg-[#304538]">
          <span class="text-xl font-bold sm:text-2xl">
            {i18n.DESTINATIONS_ANDALUSIA}
          </span>
          <svg
            class="h-6 w-6 shrink-0 text-[#ff5e00] transition-transform duration-300 group-hover:translate-x-1.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </div>
      </a>

      <a
        href={translatePath("leisure-cycling-italia")}
        class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#3c5546]/10 bg-white shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ff5e00]">
        <div
          class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#f3f5f2] to-[#e9eee9] p-6">
          <img
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            src="/destinations/italia.webp"
            alt="Italy map"
            loading="lazy"
          />
          <span
            class="absolute left-5 top-5 h-1 w-10 rounded-full bg-[#ff5e00]">
          </span>
        </div>
        <div
          class="flex flex-1 items-center justify-between gap-4 bg-[#3c5546] px-5 py-5 text-white transition-colors group-hover:bg-[#304538]">
          <span class="text-xl font-bold sm:text-2xl">
            {i18n.DESTINATIONS_ITALY}
          </span>
          <svg
            class="h-6 w-6 shrink-0 text-[#ff5e00] transition-transform duration-300 group-hover:translate-x-1.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </div>
      </a>

      <a
        href={translatePath("leisure-cycling-spain")}
        class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[#3c5546]/10 bg-white shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ff5e00]">
        <div
          class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#f3f5f2] to-[#e9eee9] p-6">
          <img
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            src="/destinations/spain.png"
            alt="Spain map"
            loading="lazy"
          />
          <span
            class="absolute left-5 top-5 h-1 w-10 rounded-full bg-[#ff5e00]">
          </span>
        </div>
        <div
          class="flex flex-1 items-center justify-between gap-4 bg-[#3c5546] px-5 py-5 text-white transition-colors group-hover:bg-[#304538]">
          <span class="text-xl font-bold sm:text-2xl">
            {i18n.DESTINATIONS_SPAIN}
          </span>
          <svg
            class="h-6 w-6 shrink-0 text-[#ff5e00] transition-transform duration-300 group-hover:translate-x-1.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </div>
      </a>
    </div>
  </Container>
</Layout>
