---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import Card from "../../components/card.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const ROADBIKEPRODUCTS = [
  {
    name: "Sierra Nevada – Tropical Coast E-Bike Tour | 1 Day",
    description: "Lemon Groves, Green Valleys & Rural Granada",
    href: translatePath("from-mountains-to-coastline"),
    href_img:
      "/cycle-tour/leisure-cycling/from-montains-to-coastline/from-montains-to-coastline.webp",
    alt_img: "string",
  },

  {
    name: i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.TITLE,
    description: i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.SUBTITLE,
    href: translatePath("cycle-ronda-cordoba"),
    href_img:
      "/cycle-tour/leisure-cycling/cycle-journey-andalusia/jrc-product.webp",
    alt_img: "img2",
  },
  {
    name: "Granada – Sierra Nevada E-Bike Tour | 8 Days",
    description: "Mountain Scenery, White Villages & Local Culture",
    description2: "",
    href: translatePath("cycle-tour-granada"),
    href_img: "/cycle-tour/leisure-cycling/cycle-tour-granada/ctg-product.webp",
    alt_img: "img2",
  },
  {
    name: "From Gorafe's Badlands to Cabo de Gata's Coast",
    description: "Granada – Almería E-Bike Tour | 10 Days",
    description2: "(COMING SOON)",
    badge: "new",
    href: "#",
    href_img:
      "/cycle-tour/leisure-cycling/coast-to-cabo-de-gata/gorafe-desert.webp",
    alt_img: "img2",
  },
  {
    name: "Cabo de Gata E-Bike Tour | 4 Days",
    description: "Coastal Landscapes & Gastronomy ",
    description2: "(COMING SOON)",
    badge: "new",
    href: "#",
    href_img: "/cycle-tour/leisure-cycling/cabo-4-days/cabo-faro.webp",
    alt_img: "img2",
  },
];
---

<Layout title="Tour Bike Products">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Tour Bike</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <main class="mt-32">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
        {
          ROADBIKEPRODUCTS.map((tour) => (
            <li class="mb-10">
              <Card {...tour} />
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
