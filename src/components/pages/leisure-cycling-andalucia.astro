---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import Card from "../../components/card.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const ROADBIKEPRODUCTS = [
  {
    name: i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.TITLE,
    description:
      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.SUBTITLE,
    href: translatePath("from-mountains-to-coastline"),
    href_img:
      "/cycle-tour/leisure-cycling/from-montains-to-coastline/from-montains-to-coastline.webp",
    alt_img: "string",
  },

  {
    name: i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.TITLE,
    description: i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.SUBTITLE,
    href: translatePath("cycle-ronda-cordoba"),
    href_img:
      "/cycle-tour/leisure-cycling/cycle-journey-andalusia/jrc-product.webp",
    alt_img: "img2",
  },

  {
    name: "Cycle Tour Sierra Nevada - Cabo de Gata E-bike Tour 8 days ",
    description: "(COMING SOON)",
    href: "#",
    href_img: "/cycle-tour/leisure-cycling/cabo/cabo-product.webp",
    alt_img: "img2",
  },
];
---

<Layout title="Tour Bike Products">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Tour Bike</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <main class="mt-32">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
        {
          ROADBIKEPRODUCTS.map((tour) => (
            <li class="mb-10">
              <Card {...tour} />
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
