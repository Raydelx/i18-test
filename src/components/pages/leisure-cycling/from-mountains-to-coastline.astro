import AccordionProducts from "@/components/accordionProducts.astro";
import cycleSardiniaNl from "@/data_files/cycleMediterraneanSea.json";

import { getI18N } from "@/i18n/";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// Duplica y cambia las rutas para añadir o modificar las fotos

const IMG = [
  {
    src: "/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-5.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-6.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-7.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-8.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-9.webp",
  },
];
const DAYS = [
  {
