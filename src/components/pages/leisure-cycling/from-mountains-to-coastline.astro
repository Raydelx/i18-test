      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-3 mt-20 md:mt-26 md:mb-36 gap-16 md:gap-20">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .INCLUDED.TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_1
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_2
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_3
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_4
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_5
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_6
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_7
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_8
                }
              </p>
            </li>
          </ul>
        </Includes>
        <!-- Exclude -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .NOT_INCLUDED.TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .NOT_INCLUDED.TEXT_1
                }
              </p>
            </li>
          </div>
        </Includes>
        <!-- Complementaries -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.EXTRA
            .TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex flex-wrap gap-2">
              <Icon icon="complement-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .EXTRA.TEXT_1
                }
              </p>
            </li>
          </div>
          <li class="flex flex-wrap gap-2">
            <Icon icon="complement-logo" size="1.6rem" color="#0E46A3" />
            <p class="max-w-[320px] text-md">
              {
                i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.EXTRA
                  .TEXT_2
              }
            </p>
          </li>
        </Includes>
      </div>
    </main>

    <div class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 md:py-36 py-10">
      <div class="static h-[385px] hidden md:block">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[12rem] md:mt-48 lg:mt-60 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature2.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature3.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5">
        <div class="">
          <h2
            class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .AVAILABILITY
            }
          </h2>

          <ul class="grid gap-2 text-lg">
            <li class="flex flex-wrap gap-2">
              <Icon icon="spring-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_1
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="summer-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_2
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_3
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="winter-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_4
                }
              </p>
            </li>
          </ul>
        </div>

        <div class="">
          <h2
            class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .HIGHLIGHT
            }
          </h2>
          <p class="text-lg text-gray-900 mb-1">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .HIGHLIGHT_TEXT_1
            }
          </p>
          <p class="text-lg text-gray-900">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .HIGHLIGHT_TEXT_2
            }
          </p>
          <p class="text-lg text-gray-900">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .HIGHLIGHT_TEXT_3
            }
          </p>
          <p class="text-lg text-gray-900">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .HIGHLIGHT_TEXT_4
            }
          </p>
          <p class="text-lg text-gray-900">
            <span class="text-xl">🔹</span>
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .HIGHLIGHT_TEXT_5
            }
          </p>
        </div>
      </div>
    </div>

    <Widget
      title={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
        .WHAT_TO_BRING.TITLE}
      description={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
        .WHAT_TO_BRING.TEXT_1}
      img="/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-2.webp"
      text={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
        .WHAT_TO_BRING.TEXT_2}
      brings={brings}
    />

    <!-- Button to download PDF -->
    <section class="grid md:grid-cols-2 gap-10">
      <div class="">
        <h2
          class="max-w-2xl mb-4 md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
          {
            i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .REQUIEREMENTS
          }
        </h2>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔹</span>
          {
            i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .REQUIEREMENTS_TEXT_1
          }
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .REQUIEREMENTS_TEXT_2
