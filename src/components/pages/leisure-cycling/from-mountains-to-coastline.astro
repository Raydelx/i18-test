---

<Layout title="">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-cover bg-no-repeat bg-[url('/public/cycle-tour/leisure-cycling/from-montains-to-coastline/from-montains-to-coastline.webp')] h-[25rem] rounded-2xl">
        <div class="flex flex-col justify-end h-full p-6 w-auto bg-cover">
          <div class="flex gap-2">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              {
                i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                  .LOCATION
              }
            </p>
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            {i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.TITLE}
          </h1>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .PRICE}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .PRE_BOOKING}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .MINUMUM_OF_PERSONS}>
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .DURATION}>
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .TOUR_TYPE}>
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle2={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .SEASON}>
          <!-- <div slot="icon">
            <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
          </div> -->
        </InformationProducts>
      </div>

      <!-- Informacion tecnica -->

      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .TOTAL_DISTANCE}>
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .TOTAL_ASCENT}>
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#ff5e00" />
            </div>
