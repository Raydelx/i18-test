      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-2 mt-20 md:mt-26 md:mb-36 gap-16 md:gap-20">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
            .INCLUDED.TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_1
                }
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_2
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_3
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_4
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_5
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_6
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_7
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .INCLUDED.TEXT_8
