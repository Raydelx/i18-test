      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.DAY_1.TEXT_1,
    optional1:
      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.DAY_1.TEXT_2,
    optional2:
      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.DAY_1.TEXT_3,
    totalDistance: "50 km",
    totalAscent: "450 m",
    totalDescent: "1350 m",
    duration: "3 hours",
