];

const brings = [
  {
    title:
      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.WHAT_TO_BRING
        .BRING_1,
  },
  {
    title:
      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.WHAT_TO_BRING
        .BRING_2,
  },
  {
    title:
      i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.WHAT_TO_BRING
        .BRING_3,
  },
];

const BIKES = [
  {
    src: "/cycle-tour/leisure-cycling/cycle-tour-granada/bike-1.webp",
  },
];

const travelInfo = {
  subTitle:
    i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.WHAT_TO_EXPECT,
  cycleSardiniaEs: [
    {
      name: i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
        .WHAT_TO_EXPECT,
      text1:
        i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.LEVEL_TEXT_1,
    },
    {
      name: i18n.INFO_PRODUCTS.DURATION,
      text1: i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE.DURATION,
    },
    {
      name: i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
        .REQUIEREMENTS,
