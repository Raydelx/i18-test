        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-4.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[12rem] md:mt-30 lg:mt-35 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-6.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-8.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5">
        <div class="">
          <h2
            class="max-w-2xl mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-2 rounded-lg">
            {
              i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                .AVAILABILITY
            }
          </h2>

          <ul class="grid gap-2 text-lg">
            <li class="flex flex-wrap gap-2">
              <Icon icon="spring-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_1
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="summer-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_2
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="autumn-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_3
                }
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="winter-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {
                  i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
                    .AVAILABILITY_TEXT_4
                }
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 mt-10 items-center">
      <div>
        <h2
          class="max-w-2xl mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-2 rounded-lg">
          Bicycle
        </h2>
        <p>🔶 E-Bike Bergamont E REVOX SPORT</p>
      </div>
      <div class="w-full overflow-x-auto">
        <ol class="w-full">
          {(<SliderReact IMG={BIKES} client:visible />)}
        </ol>
      </div>
    </div>

    <AccordionProducts
      title="Travel<br />Information"
      cycleSardiniaEs={cycleSardiniaNl}
    />

    <div class="grid lg:grid-cols-2 gap-4 items-center">
      <div>
        <h2
          class="mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-4 rounded-lg">
          What to pack for your cycle tour
        </h2>
        <p class="mb-2">
          A well-packed bag makes a smoother ride! Here’s what we recommend for
          your cycle tour through Granada.
        </p>

        <p>🔶 Comfortable clothing and shoes</p>
        <p>🔶 Sun Protection</p>
        <p>🔶 Small bag with extra snacks</p>
        <p>🔶 Lightweight windproof and/or waterproof jacket (rain jacket)</p>
        <p>🔶 Sweater or fleece (extra layers for cooler conditions)</p>

        <p class="mb-2">
          If you have any questions about the recommended equipment or are
          unsure what to bring, please do not hesitate to contact us.
        </p>
      </div>
      <div>
        <img
          class="rounded-2xl"
          src="/cycle-tour/leisure-cycling/from-montains-to-coastline/fmtc-map.webp"
          alt="Kaart van Sardinië-tour"
        />
      </div>
    </div>

    <!-- Button to download PDF -->
    <section class="grid md:grid-cols-2 gap-10 mt-16">
      <div class="">
        <h2
          class="mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-4 rounded-lg">
          {
            i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .REQUIEREMENTS
          }
        </h2>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          Good physical health
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          Minimum age and height: 11 years and 1.50 m
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          Closed shoes, no open shoes!
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          You are capable of controlling bicycle speed and direction on paved roads
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          You can brake, and use gears with confidence
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          Signed release of liability form, to be completed before the start of the
          tour
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          Helmet, mandatory during all rides
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          Personal responsibility for health, fitness and any existing medical conditions
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔶</span>
          Emergency contact information, to be provided before departure
        </p>
      </div>
      <div>
        <h2
          class="max-w-2xl mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-2 rounded-lg">
          Terms & Conditions
        </h2>
        <p class="max-w-2xl mb-6 md:px-0 text-lg">
          Please review our <a
            href="terms-and-conditions"
            class="text-[#ff5e00] hover:text-[#ff863f] visited:text-purple-600 font-bold"
            target="_blank"
            rel="noopener noreferrer">Terms & Conditions</a
          > before completing your booking. By confirming your reservation, you agree
          to all policies regarding payments, cancellations, and participation requirements.
        </p>
      </div>
    </section>

    <!-- Slider Photos -->
