        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {
            i18n.PRODUCTS.LEISURE_CYCLING.FROM_MOUNTAINS_TO_COASTLINE
              .REQUIEREMENTS_TEXT_3
