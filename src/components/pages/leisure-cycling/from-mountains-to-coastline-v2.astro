    .fm2-reveal,
    .fm2-rise {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Scroll reveal
  const reveal = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          reveal.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  document.querySelectorAll(".fm2-reveal").forEach((el) => reveal.observe(el));

  // Count-up numbers
  const counters = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        counters.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const unit = el.dataset.unit ?? "";
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / 1400, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(end * eased) + unit;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    },
    { threshold: 0.6 },
  );
  if (!reduce) {
    document
      .querySelectorAll<HTMLElement>("[data-count]")
      .forEach((el) => counters.observe(el));
  }

  // Hero parallax
  const bg = document.querySelector<HTMLElement>("[data-parallax]");
  if (bg && !reduce) {
    window.addEventListener(
      "scroll",
      () => {
        const y = Math.min(window.scrollY, 900);
        bg.style.transform = `translateY(${y * 0.25}px)`;
      },
      { passive: true },
    );
  }

  // Active section in nav
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) =>
          l.classList.toggle("is-active", l.dataset.nav === e.target.id),
        );
      });
    },
    { rootMargin: "-35% 0px -60% 0px" },
  );
  links.forEach((l) => {
    const target = document.getElementById(l.dataset.nav ?? "");
    if (target) spy.observe(target);
  });

  // Gallery arrows and lightbox
  const track = document.querySelector<HTMLElement>("[data-track]");
  document.querySelectorAll<HTMLElement>(".fm2-arrows button").forEach((b) =>
    b.addEventListener("click", () => {
      const dir = Number(b.dataset.dir);
      track?.scrollBy({ left: dir * 340, behavior: "smooth" });
    }),
  );
  const dialog = document.querySelector<HTMLDialogElement>("[data-dialog]");
  const full = dialog?.querySelector("img");
  document.querySelectorAll<HTMLElement>(".fm2-slide").forEach((s) =>
    s.addEventListener("click", () => {
      if (full) full.src = s.dataset.full ?? "";
      dialog?.showModal();
    }),
  );
  dialog?.addEventListener("click", () => dialog.close());
</script>
