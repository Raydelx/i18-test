---
import Container from "../../../components/container.astro";
import InformationProducts from "../../../components/ui/informationProducts.astro";
import Icon from "../../../components/Icon.astro";
import Layout from "../../../layouts/Layout.astro";
import SliderReact from "../../../hooks/SliderReact";
import Days from "../../../components/products-components/days.astro";
import Includes from "../../../components/products-components/includes.astro";
import Cancellation from "../../../components/products-components/cancellation.astro";
import Widget from "@/components/products-components/widget.astro";
import Dots from "@/components/ui/dots.astro";
import Route from "@/components/ui/icons/route.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// Duplica y cambia las rutas para añadir o modificar las fotos

const IMG = [
  {
    src: "/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-1.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-2.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-3.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-4.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-5.webp",
  },
];

const brings = [
  {
    title: i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_BRING_TEXT_2,
  },
  {
    title: i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_BRING_TEXT_3,
  },
  {
    title: i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_BRING_TEXT_4,
  },
  {
    title: i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_BRING_TEXT_5,
  },
  {
    title: i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_BRING_TEXT_6,
  },
];

const DAYS = [
  {
    day: "1",
    tecnicalInfo: true,
    description:
      i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_EXPECT_TEXT_1,
    totalDistance: "All Levels",
    totalAscent: "All Levels",
    totalDescent: "All Levels",
    duration: "4 - 6 hours",
  },
];
---

<Layout title="Gravel Bike / MTB">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-no-repeat bg-[url('/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-principal.webp')] bg-cover h-[30rem] rounded-2xl">
        <div class="flex flex-col justify-end h-full p-6 w-auto">
          <div class="flex gap-2">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.LOCATION}
            </p>
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.TITLE}
          </h1>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.PRICE}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.PRE_BOOKING}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE
            .MINUMUM_OF_PERSONS}>
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>

        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.DURATION}>
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.TOUR_TYPE}>
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle2={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.SEASON}>
          <!-- <div slot="icon">
            <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
          </div> -->
        </InformationProducts>
      </div>
      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.TOTAL_DISTANCE}>
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.TOTAL_ASCENT}>
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DESCENT}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.TOTAL_DESCENT}>
            <div slot="icon">
              <Icon icon="down-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.ROUTE_TYPE}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.ROUTE_TYPE}>
            <Route />
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.DIFFICULTY}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.DIFFICULTY}>
            <div slot="icon"></div>
          </InformationProducts>
          <InformationProducts title="MTB" subtitle="Yes">
            <div slot="icon">
              <Icon icon="bike-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
        </div>
      </div>
    </main>

    <!-- Informacion tecnica -->

    <!--  Include, exclude, complementaries  -->
    <div
      class="grid md:grid-cols-2 lg:grid-cols-2 mt-20 md:mt-26 md:mb-36 gap-16 md:gap-4">
      <!-- Include -->
      <Includes
        title={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TITLE}>
        <ul slot="description" class="mt-4 flex flex-col gap-2">
          <li class="flex gap-2">
            <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TEXT_1}
            </p>
          </li>
          <li class="flex gap-2">
            <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TEXT_2}
            </p>
          </li>
          <li class="flex gap-2">
            <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TEXT_3}
            </p>
          </li>
          <li class="flex gap-2">
            <div>
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
            </div>
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TEXT_4}
            </p>
          </li>
          <li class="flex gap-2">
            <div>
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
            </div>
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TEXT_5}
            </p>
          </li>
          <li class="flex gap-2">
            <div>
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
            </div>
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.INCLUDED.TEXT_6}
            </p>
          </li>
        </ul>
      </Includes>
      <!-- Exclude -->
      <Includes
        title={i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.NOT_INCLUDED.TITLE}>
        <div slot="description" class="flex flex-col gap-2 mt-4">
          <li class="flex flex-wrap gap-2">
            <Icon icon="uncheck-logo" size="1.6rem" color="#0E46A3" />
            <p class="max-w-[320px] text-md">
              {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.NOT_INCLUDED.TEXT_1}
            </p>
          </li>
        </div>
      </Includes>
      <!-- Complementaries -->
    </div>

    <div class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 py-10 items-center">
      <div class="static h-[385px] hidden md:block content-center">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[30rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-5.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[20rem] md:mt-48 lg:mt-45 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-1.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[18em] ml-64 md:-mt-40 lg:-mt-24 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-4.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5">
        <div class="">
          <h2
            class="max-w-2xl md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.AVAILABILITY}
          </h2>
          <Dots class="mb-4" />

          <ul class="grid gap-2 text-lg">
            <li class="flex flex-wrap gap-2">
              <Icon icon="spring-logo" size="1.6rem" color="#0E46A3" />
              <p>
                {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.AVAILABILITY_TEXT_1}
              </p>
            </li>
          </ul>
        </div>
        <div>
          <h2
            class="max-w-2xl md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.HIGHLIGHT}
          </h2>
          <Dots class="mb-4" />
          <p class="text-lg text-gray-900">
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.HIGHLIGHT_TEXT_1}
          </p>
        </div>

        <div class="">
          <h2
            class="max-w-2xl md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.REQUIEREMENTS}
          </h2>
          <Dots class="mb-4" />
          <p class="text-lg text-gray-900">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.REQUIEREMENTS_TEXT_1}
          </p>
          <p class="text-lg text-gray-900">
            <span class="text-xl">🔹</span>
            {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.REQUIEREMENTS_TEXT_2}
          </p>
          to the right level.
        </div>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.REQUIEREMENTS_TEXT_3}
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.REQUIEREMENTS_TEXT_4}
        </p>
      </div>
    </div>

    <Widget
      title="What to bring for cycling"
      description="Weather is important to consider while packing for your outdoor activity. Your packing list is based on your comfort and sensitivity. The best way to travel and to be outdoors is to layer your clothes. Highly recommended as best way to stay warm and keep cool, as the weather is bound to change in the mountains."
      img="/cycle-tour/montainbike/mtb-trails-granada/mtb-tg-6.webp"
      text="We help you fit your pedals, saddle, etc. if you'd like to bring them. Any questions about the recommendations of the material do not hesitate to contact us. "
      brings={brings}
    />
    <div class="grid md:grid-cols-2 gap-6 md:gap-12 mt-10">
      <div class="mb-6 md:mb-20">
        <h2
          class="max-w-2xl md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.MTB}
        </h2>
        <Dots class="mb-4" />
        <p class="text-lg text-gray-900 mb-2">
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.MTB_TEXT_1}
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.MTB_TEXT_2}
        </p>
        <p class="text-lg text-gray-900">
          <span class="text-xl">🔹</span>
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.MTB_TEXT_3}
        </p>
      </div>
      <div class="mb-6 md:mb-20">
        <h2
          class="max-w-2xl md:px-0 font-bold text-4xl md:text-5xl xl:text-6xl">
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.LEVEL}
        </h2>
        <Dots class="mb-4" />
        <p class="text-lg text-gray-900 mb-2">
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.LEVEL_TEXT_1}
        </p>
      </div>
    </div>

    <!-- Button to download PDF -->
    <section class="grid md:grid-cols-2 gap-6 items-center">
      <Cancellation />
      <div class="flex flex-col gap-2 md:p-4">
        <div>
          <h3 class="text-4xl md:text-5xl xl:text-6xl font-bold">Price:</h3>
          <Dots class="mb-4" />
        </div>
        <p>1 person - 170 €</p>
        <p>2 people - 140 € p.p</p>
        <p>3 people - 130 € p.p</p>
        <p>4 people - 105 € p.p</p>
        <p>5 people - 100 € p.p</p>
        <p>7 people - 95 € p.p</p>
      </div>
    </section>

    <!-- Slider Photos -->
    <section class="m-auto md:w-full rounded-xl md:px-8 md:py-20">
      <ol class="relative mt-16">
        {(<SliderReact IMG={IMG} client:visible />)}
      </ol>
    </section>

    <!--  TimeLine per days  -->
    <h2 class="text-4xl md:text-5xl xl:text-6xl md:p-4 mt-16 font-bold mb-4">
      {i18n.PRODUCTS.GRAVEL_BIKE.MTB_TRAILS_BIKE.WHAT_TO_EXPECT}
    </h2>

    {
      DAYS.map((tour) => (
        <ol class="mb-10">
          <Days {...tour} />
        </ol>
      ))
    }
  </Container>
</Layout>
