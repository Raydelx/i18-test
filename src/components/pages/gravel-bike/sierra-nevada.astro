---
import Container from "../../../components/container.astro";
import InformationProducts from "../../../components/ui/informationProducts.astro";
import Icon from "../../../components/Icon.astro";
import Layout from "../../../layouts/Layout.astro";
import SliderReact from "../../../hooks/SliderReact";
import Days from "@/components/products-components/days.astro";
import Includes from "@/components/products-components/includes.astro";
import Route from "@/components/ui/icons/route.astro";
import AccordionProducts from "@/components/accordionProducts.astro";
import cycleMtbSierraNevada from "@/data_files/cycleMtbSierraNevadaEs.json";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// Duplica y cambia las rutas para añadir o modificar las fotos

const IMG = [
  {
    src: "/cycle-tour/montainbike/sierra-nevada/sn1.webp",
  },
  {
    src: "/cycle-tour/montainbike/sierra-nevada/sn2.webp",
  },
  {
    src: "/cycle-tour/montainbike/sierra-nevada/sn3.webp",
  },
  {
    src: "/cycle-tour/montainbike/sierra-nevada/sn4.webp",
  },
  {
    src: "/cycle-tour/montainbike/sierra-nevada/sn5.webp",
  },
];
const DAYS = [
  {
    day: "1",
    tecnicalInfo: true,
    description: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.WHAT_TO_EXPECT_TEXT_1,
    description2: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.WHAT_TO_EXPECT_TEXT_2,
    description3: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.WHAT_TO_EXPECT_TEXT_3,
    description4: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.WHAT_TO_EXPECT_TEXT_4,
    description5: i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.WHAT_TO_EXPECT_TEXT_5,
    totalDistance: "58 km",
    totalAscent: "500 m",
    totalDescent: "1700 m",
    duration: "5 hours",
  },
];

const BIKES = [
  {
    src: "/cycle-tour/montainbike/sierra-nevada/sierranevada-1.webp",
  },
];
---

<Layout title="Gravel Bike / MTB">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-no-repeat bg-[url('/public/cycle-tour/montainbike/sierra-nevada/info-sierranevada.webp')] bg-cover h-[30rem] rounded-2xl">
        <div class="flex flex-col justify-end h-full p-6 w-auto">
          <div class="flex gap-2">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.LOCATION}
            </p>
          </div>

          <h1
            class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.TITLE}
          </h1>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.PRICE}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.PRE_BOOKING}>
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.MINUMUM_OF_PERSONS}>
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.DURATION}>
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.TOUR_TYPE}>
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#0E46A3" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle2={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.SEASON}>
          <!-- <div slot="icon">
            <Icon icon="autumn-logo" size="1.6rem" color="#0E46A3" />
          </div> -->
        </InformationProducts>
      </div>

      <!-- Informacion tecnica -->

      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.TOTAL_DISTANCE}>
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.TOTAL_ASCENT}>
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DESCENT}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.TOTAL_DESCENT}>
            <div slot="icon">
              <Icon icon="down-logo" size="1.6rem" color="#0E46A3" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.ROUTE_TYPE}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.ROUTE_TYPE}>
            <div slot="icon">
              <Route />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.DIFFICULTY}
            subtitle={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.DIFFICULTY}>
            <div slot="icon"></div>
          </InformationProducts>
          <InformationProducts title="E-Bike" subtitle="Yes">
            <div slot="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="45"
                height="30"
                fill="#0E46A3"
                viewBox="80 90 330 330"
                ><path
                  d="M83.172,319.817Q85.646,320,88.1,320A64,64,0,0,0,136.544,214.29a64.376,64.376,0,0,0-11.981-10.841l9.59-17.982,46.293,46.293A31.986,31.986,0,1,0,235.7,264h20.823a64.023,64.023,0,1,0,42.47-68.439l-10.025-19.605L300.944,152H316a20,20,0,0,0,0-40H276a20,20,0,0,0,0,40h7.053l-8,16H143.469l16.49-30.918L160,137l4.8-9H200a8,8,0,0,0,0-16H166.624A24.039,24.039,0,0,0,144,96H120a8,8,0,0,0-8,8v32a8,8,0,0,0,8,8h18.136l-27.748,52.028a64.045,64.045,0,0,0-86.2,55.141h0A64.072,64.072,0,0,0,83.172,319.817ZM312,256a8,8,0,1,1,8,8A8.009,8.009,0,0,1,312,256Zm-20-38.953L303.183,238.9a24.037,24.037,0,0,0-5.8,9.1h-24.7A48.052,48.052,0,0,1,292.007,217.047Zm-14.122-27.618,6.775,13.25A64.062,64.062,0,0,0,256.521,248H240a31.8,31.8,0,0,0-4.446-16.244ZM260.686,184l-36.443,36.443a31.9,31.9,0,0,0-32.483,0L155.314,184ZM96,256a8,8,0,1,1-8-8A8.009,8.009,0,0,1,96,256Z"
                ></path><path
                  d="M380,168H344v16h36a92,92,0,0,1,0,184H327.324a47.991,47.991,0,0,0-94.642,0H190.99A32.057,32.057,0,0,0,160,344H120a8,8,0,0,0-8,8H96a8,8,0,1,0,0,16h16v16H96a8,8,0,1,0,0,16h16a8,8,0,0,0,8,8h40a32.057,32.057,0,0,0,30.987-24h41.692a47.991,47.991,0,0,0,94.642,0H380a108,108,0,0,0,0-216ZM294.659,380.438l-16,24-13.312-8.876L273.055,384H272a8,8,0,0,1-6.653-12.438l16-24,13.312,8.876L286.951,368H288a8,8,0,0,1,6.656,12.438Z"
                ></path></svg
              >
            </div>
          </InformationProducts>
        </div>
      </div>

      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-3 mt-20 md:mt-26 md:mb-36 gap-16 md:gap-20">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_1}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_2}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_3}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_4}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_5}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_6}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#0E46A3" />
              <p class="max-w-[320px] text-md">
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.INCLUDED.TEXT_7}
              </p>
            </li>
          </ul>
        </Includes>
        <!-- Exclude -->

        <!-- Complementaries -->
      </div>
    </main>

    <div class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 md:py-36 py-10">
      <div class="static h-[385px] hidden md:block">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[12rem] md:mt-48 lg:mt-60 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature2.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature3.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5">
        <div class="">
          <h2
            class="max-w-2xl mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-2 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
            {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.AVAILABILITY}
          </h2>

          <ul class="grid gap-2 text-lg">
            <li class="flex flex-wrap gap-2">
              <Icon icon="spring-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.AVAILABILITY_SPRING}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="summer-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.AVAILABILITY_SUMMER}
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="autumn-logo" size="1.6rem" color="#ff5e00" />
              <p>
                {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.AVAILABILITY_AUTUMN}
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 items-center gap-2 lg:grid-cols-2">
      <div>
        <h2
          class="max-w-2xl mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-2 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
          Bicycle
        </h2>
        <p>🔶 E-bike included in the tour</p>
      </div>
      <div class="w-full overflow-x-auto">
        <ol class="w-full">
          {(<SliderReact IMG={BIKES} client:visible />)}
        </ol>
      </div>
    </div>

    <AccordionProducts
      title="Travel<br />Information"
      cycleSardiniaEs={cycleMtbSierraNevada}
    />

    <div class="mb-14 grid items-center gap-4 lg:mb-20 lg:grid-cols-2">
      <div>
        <h2
          class="mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-4 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
          What to pack for your cycle tour
        </h2>
        <p class="mb-2">
          A well-packed bag makes a smoother ride! Here's what we recommend for
          your cycle tour through Granada.
        </p>

        <p>🔶 Comfortable clothing and shoes</p>
        <p>🔶 Sun protection</p>
        <p>🔶 Small bag with extra snacks</p>
        <p>🔶 Lightweight windproof and/or waterproof jacket (rain jacket)</p>
        <p>🔶 Sweater or fleece (extra layers for cooler conditions)</p>

        <p class="mb-2">
          If you have any questions about the recommended equipment or are
          unsure what to bring, please do not hesitate to contact us.
        </p>
      </div>
      <div>
        <img
          class="rounded-2xl"
          src="/cycle-tour/montainbike/sierra-nevada/sierra-feature.webp"
          alt="Cyclist in the Sierra Nevada mountains"
        />
      </div>
    </div>

    <section class="grid md:grid-cols-2">
      <div class="">
        <h2
          class="max-w-2xl mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-2 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
          {i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT.REQUIEREMENTS}
        </h2>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_1
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_2
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_3
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_4
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_5
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_6
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_7
          }
        </p>
        <p class="text-lg text-gray-900 mb-1">
          <span class="text-xl strong">🔶</span>
          {
            i18n.PRODUCTS.GRAVEL_BIKE.MTB_SIERRA_NEVADA_DESERT
              .REQUIEREMENTS_TEXT_8
          }
        </p>
      </div>

      <div>
        <h2
          class="max-w-2xl mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-2 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
          Terms & Conditions
        </h2>
        <p class="max-w-2xl mb-6 md:px-0">
          Please review our <a
            href="terms-and-conditions"
            class="font-bold text-[#ff5e00] hover:text-[#ff863f] visited:text-purple-600"
            target="_blank"
            rel="noopener noreferrer">Terms & Conditions</a
          > before completing your booking. By confirming your reservation, you agree
          to all policies regarding payments, cancellations, and participation requirements.
        </p>
      </div>
    </section>

    <!-- Slider Photos -->
    <section class="m-auto md:w-full rounded-xl md:px-8 md:py-20">
      <ol class="relative mt-16">
        {(<SliderReact IMG={IMG} client:visible />)}
      </ol>
    </section>

    <!--  TimeLine per days  -->
    <h2 class="text-4xl md:text-5xl xl:text-6xl md:p-8 mt-16 font-bold mb-4">
      {i18n.PRODUCTS.GRAVEL_BIKE.SIERRA_NEVADA.WHAT_TO_EXPECT}
    </h2>
    {
      DAYS.map((tour) => (
        <ol class="mb-10">
          <Days {...tour} />
        </ol>
      ))
    }
  </Container>
</Layout>
