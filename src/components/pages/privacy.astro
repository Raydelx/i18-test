---
import Sectionhead from "@/components/sectionhead.astro";
import Container from "@/components/containerInfo.astro";
import Layout from "@/layouts/Layout.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<Layout title="Pricay Policy">
  <Sectionhead>
    <Fragment slot="title"> {i18n.PRIVACY.TITLE}</Fragment>
    <Fragment slot="desc"></Fragment>
  </Sectionhead>
  <Container class="w-full mt-16">
    <p class="mb-4">{i18n.PRIVACY.INTRO}</p>

    <p class="mb-4">
      🔵 {i18n.PRIVACY.ENTITY}
    </p>
    <p class="mb-4">
      🔵 {i18n.PRIVACY.TAX}
    </p>
    <p class="mb-4">
      🔵 {i18n.PRIVACY.ADDRESS}
    </p>
    <p class="mb-4">
      🔵 {i18n.PRIVACY.PHONE}
    </p>
    <p class="mb-8">
      🔵 {i18n.PRIVACY.EMAIL}
    </p>

    <div class="mt-8">
      <h2 class="text-xl font-bold mb-4">
        {i18n.PRIVACY.PURPOSE_1}
      </h2>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_2}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_3}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_4}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_5}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_6}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_7}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_8}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.PURPOSE_9}
      </p>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-bold mb-4">
        {i18n.PRIVACY.LEGAL_1}
      </h2>
      <p class="mb-4">
        {i18n.PRIVACY.LEGAL_2}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.LEGAL_3}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.LEGAL_4}
      </p>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-bold mb-4">
        {i18n.PRIVACY.RECIPIENTS_1}
      </h2>
      <p class="mb-4">
        {i18n.PRIVACY.RECIPIENTS_2}
      </p>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-bold mb-4">
        {i18n.PRIVACY.DATA_DETENTION}
      </h2>
      <p class="mb-4">
        {i18n.PRIVACY.DATA_DETENTION_1}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.DATA_DETENTION_2}
      </p>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-bold mb-4">
        {i18n.PRIVACY.RIGHTS}
      </h2>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_1}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_2}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_3}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_4}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_5}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_6}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_7}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_8}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_9}
      </p>
      <p class="mb-4">
        {i18n.PRIVACY.RIGHTS_10}
      </p>

      <div class="mt-8">
        <h2 class="text-xl font-bold mb-4">
          {i18n.PRIVACY.MINOR_CONSENT_1}
        </h2>
        <p class="mb-4">
          {i18n.PRIVACY.MINOR_CONSENT_2}
        </p>
      </div>

      <div class="mt-8">
        <h2 class="text-xl font-bold mb-4">
          {i18n.PRIVACY.ACCURACY_1}
        </h2>
        <p class="mb-4">
          {i18n.PRIVACY.ACCURACY_2}
        </p>
        <p class="mb-4">
          {i18n.PRIVACY.ACCURACY_3}
        </p>
        <p class="mb-4">
          {i18n.PRIVACY.ACCURACY_4}
        </p>
        <p class="mb-4">
          {i18n.PRIVACY.ACCURACY_5}
        </p>
        <p class="mb-4">
          {i18n.PRIVACY.ACCURACY_6}
        </p>
      </div>

      <div class="mt-8">
        <h2 class="text-xl font-bold mb-4">
          {i18n.PRIVACY.COMPLAINTS_1}
        </h2>
        <p class="mb-4">
          {i18n.PRIVACY.COMPLAINTS_2}
        </p>
      </div>
    </div>
  </Container>
</Layout>
