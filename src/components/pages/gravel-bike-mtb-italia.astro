---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import Card from "../../components/card.astro";

import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const GRAVELKBIKE = [
  {
    name: i18n.PRODUCTS.GRAVEL_BIKE.MTB_SARDINIA.TITLE,
    description: "(COMMING SOON)",
    href: "#",
    href_img: "/cycle-tour/montainbike/mtb-sardinia/sardinia-product.webp",
    alt_img: "Sardinia tour with gravel bike",
  },
];
---

<Layout title="Gravel Bike / MTB Products">
  <Container>
    <Sectionhead>
      <Fragment slot="title">MTB</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <main class="mt-32">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-12 w-full">
        {
          GRAVELKBIKE.map((tour) => (
            <li class="mb-10">
              <Card {...tour} />
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
