---
import { Dropdown as DropdownContainer, DropdownItems } from "astro-navbar";

interface MenuItem {
  title: string;
  path: string;
}

interface Props {
  title: string;
  lastItem: boolean;
  children: MenuItem[];
}

const { title, lastItem, children } = Astro.props as Props;
---

<DropdownContainer class="group relative block">
  <button
    class="flex w-full items-center gap-1 rounded-md px-3 py-2 text-gray-800 transition-colors hover:bg-[#edf2ee] hover:text-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4f6658] lg:w-auto">
    <span>{title}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="3"
      stroke="currentColor"
      class="mt-0.5 h-3 w-3 transition-transform duration-200 group-open:rotate-180">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
    </svg>
  </button>
  <DropdownItems>
    <div
      class:list={[
        "z-30 mt-1 w-full lg:absolute lg:top-full lg:mt-2 lg:w-64",
        lastItem ? "lg:right-0 origin-top-right" : "lg:left-0 origin-top-left",
      ]}>
      <div
        class="flex flex-col gap-1 overflow-hidden rounded-md border border-[#d7e2d9] bg-white/95 p-2 shadow-[0_16px_35px_rgba(60,85,70,0.18)] backdrop-blur">
        {
          children.map((item: MenuItem) => (
            <a
              href={item.path}
              class="rounded-sm px-3 py-2.5 text-sm font-semibold text-gray-800 transition-colors hover:bg-[#edf2ee] hover:text-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#4f6658]">
              {item.title}
            </a>
          ))
        }
      </div>
    </div>
  </DropdownItems>
</DropdownContainer>
