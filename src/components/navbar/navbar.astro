---
import Container from "../../components/container.astro";
import Link from "../../components/ui/link.astro";
import LanguageSelector from "../LanguageSelector.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { getI18N } from "@/i18n/";
import { getLangFromUrl, useTranslatedPath } from "../../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const menuitems = [
  {
    title: i18n.NAV.EXPERIENCE,
    path: translatePath("/"),

    children: [
      {
        title: i18n.NAV.CYCLE_TRAVELS,
        path: translatePath("cycling"),
      },
      {
        title: i18n.NAV.HIKING_TREKKING,
        path: translatePath("trekking-destinations"),
      },
      {
        title: i18n.NAV.ROAD_TRIPS,
        path: translatePath("road-trips-destinations"),
      },
      {
        title: i18n.NAV.TAILOR_MADE_TRAVELS,
        path: translatePath("tailor-made-travel"),
      },
    ],
  },

  {
    title: i18n.NAV.GALLERY,
    path: translatePath("gallery"),
  },
  {
    title: i18n.NAV.ABOUT,
    path: translatePath("about"),
  },
  {
    title: i18n.NAV.CONTACT_US,
    path: translatePath("contact"),
  },
];
---

<Container class="h-24 lg:h-28">
  <header
    id="site-navbar"
    class="fixed inset-x-0 top-3 z-50 mx-auto flex w-[calc(100%_-_2rem)] max-w-screen-2xl translate-y-0 flex-col items-center justify-between rounded-md border border-white/70 bg-white/95 px-4 py-3 opacity-100 shadow-[0_10px_30px_rgba(60,85,70,0.12)] backdrop-blur transition-[transform,opacity,box-shadow] duration-300 ease-out lg:flex-row lg:px-5">
    <Astronav>
      <div class="relative flex w-full lg:w-auto items-center justify-between">
        <a href={translatePath("/")} class="text-lg">
          <img
            src="/logo-new.webp"
            class="w-64 h-16 lg:w-90 lg:h-20 object-contain"
            alt="logo montaraz outdoors & culture"
          />
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden z-20 mt-3 w-full lg:mt-0 lg:flex lg:w-auto">
        <ul class="flex flex-col gap-1 font-semibold lg:flex-row lg:gap-1">
          {
            menuitems.map((item, index) => (
              <li>
                {item.children ? (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                ) : (
                  <a
                    href={item.path}
                    class="flex items-center rounded-md px-3 py-2 text-gray-800 transition-colors hover:bg-[#edf2ee] hover:text-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4f6658]">
                    <span>{item.title}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        <div
          class="mt-3 flex items-center gap-4 border-t border-[#d7e2d9] pt-3 lg:hidden">
          <LanguageSelector />
          <Link
            href={translatePath("tailor-made-travel")}
            size="md"
            style="orange"
            block
            >{i18n.NAV.TAILOR_MADE}
            <slot name="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="25"
                height="25"
                fill="#ffffff"
                viewBox="0 0 256 256"
                ><path
                  d="M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z"
                ></path></svg
              >
            </slot></Link
          >
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden items-center gap-3 lg:flex">
        <LanguageSelector />
        <Link
          class="font-semibold"
          href={translatePath("tailor-made-travel")}
          size="md"
          style="orange"
          icon="click-logo">
          {i18n.NAV.TAILOR_MADE}
          <slot name="icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="25"
              height="25"
              fill="#ffffff"
              viewBox="0 0 256 256"
              ><path
                d="M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z"
              ></path></svg
            >
          </slot>
        </Link>
      </div>
    </div>
  </header>
</Container>

<script>
  const navbar = document.querySelector("#site-navbar");

  if (navbar) {
    let previousScrollY = window.scrollY;
    let scrollDistance = 0;
    let scrollDirection = 0;
    let isNavbarVisible = true;
    let isTicking = false;
    const scrollThreshold = 12;

    const setNavbarVisibility = (shouldShow: boolean) => {
      if (shouldShow === isNavbarVisible) return;

      navbar.classList.toggle("-translate-y-[calc(100%+1rem)]", !shouldShow);
      navbar.classList.toggle("pointer-events-none", !shouldShow);
      navbar.classList.toggle("opacity-0", !shouldShow);
      navbar.classList.toggle("opacity-100", shouldShow);
      isNavbarVisible = shouldShow;
    };

    const updateNavbarVisibility = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const scrollDelta = currentScrollY - previousScrollY;
      const currentDirection = Math.sign(scrollDelta);

      if (currentScrollY <= scrollThreshold) {
        setNavbarVisibility(true);
        scrollDistance = 0;
      } else if (currentDirection !== 0) {
        scrollDistance =
          currentDirection === scrollDirection
            ? scrollDistance + scrollDelta
            : scrollDelta;
        scrollDirection = currentDirection;

        if (scrollDistance >= scrollThreshold) {
          setNavbarVisibility(false);
        } else if (scrollDistance <= -scrollThreshold) {
          setNavbarVisibility(true);
        }
      }

      navbar.classList.toggle(
        "shadow-[0_14px_35px_rgba(60,85,70,0.2)]",
        currentScrollY > 16,
      );

      previousScrollY = currentScrollY;
      isTicking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!isTicking) {
          window.requestAnimationFrame(updateNavbarVisibility);
          isTicking = true;
        }
      },
      { passive: true },
    );

    updateNavbarVisibility();
  }
</script>
