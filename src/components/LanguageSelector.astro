---
import ChevronIcon from "@/components/Chevron.astro";
import { LANGUAGES } from "../i18n/ui";
import {
  getRouteFromUrl,
  useTranslatedPath,
  getLangFromUrl,
} from "../i18n/utils";

const route = getRouteFromUrl(Astro.url);
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const currentLocaleData = LANGUAGES[lang];
const otherLocales = Object.values(LANGUAGES).filter(
  (locale) => locale.code !== lang,
);
const allLocales = [currentLocaleData, ...otherLocales];
---

<div class="relative inline-block text-left">
  <select
    class="group text-white rounded-md font-semibold bg-[#3c5546] hover:bg-[#4f6658] transition-all p-3"
    onchange="window.location.href=this.value"
    aria-label="Select language">
    {
      allLocales.map((locale) => (
        <option
          class="bg-green-800  text-white font-semibold rounded-4xl p-2 hover:bg-green-600 transition-all "
          style="border-radius: 2px solid transparent;"
          value={translatePath(`/${route ? route : ""}`, locale.code)}
          selected={locale.code === lang}>
          {locale.name}
        </option>
      ))
    }
  </select>
</div>
