---
import { LANGUAGES } from "../i18n/ui";
import {
  getRouteFromUrl,
  useTranslatedPath,
  getLangFromUrl,
} from "../i18n/utils";

const route = getRouteFromUrl(Astro.url);
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const currentLocaleData = LANGUAGES[lang];
const otherLocales = Object.values(LANGUAGES).filter(
  (locale) => locale.code !== lang,
);
const allLocales = [currentLocaleData, ...otherLocales];
---

<div class="relative inline-flex min-w-28 text-left">
  <details class="group relative">
    <summary
      class="flex min-w-28 cursor-pointer list-none items-center justify-between gap-2 rounded-md border border-[#3c5546] bg-[#3c5546] px-3 py-2.5 text-sm font-semibold text-white shadow-sm transition-[background-color,box-shadow] hover:bg-[#4f6658] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4f6658] group-open:bg-[#4f6658] group-open:shadow-md [&::-webkit-details-marker]:hidden"
      aria-label="Change language">
      <span>{currentLocaleData.name}</span>
      <svg
        class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
          clip-rule="evenodd"></path>
      </svg>
    </summary>
    <div
      class="absolute left-0 top-[calc(100%+0.5rem)] z-50 w-44 overflow-hidden rounded-md border border-[#d7e2d9] bg-white p-1 shadow-[0_16px_35px_rgba(60,85,70,0.18)] lg:left-auto lg:right-0">
      {
        allLocales.map((locale) => (
          <a
            href={translatePath(`/${route ? route : ""}`, locale.code)}
            aria-current={locale.code === lang ? "page" : undefined}
            class:list={[
              "flex items-center rounded-sm px-3 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#4f6658]",
              locale.code === lang
                ? "bg-[#edf2ee] text-[#3c5546]"
                : "text-gray-800 hover:bg-[#edf2ee] hover:text-[#3c5546]",
            ]}>
            {locale.name}
          </a>
        ))
      }
    </div>
  </details>
</div>
