---
import BentoItem from "../components/bentoItem.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section
  class={`
    mx-auto grid w-full max-w-[1400px] grid-cols-1 auto-rows-[20rem] gap-4
    sm:grid-cols-2 sm:auto-rows-[21rem] lg:grid-cols-10 lg:auto-rows-[22rem] md:p-10
  `}>
  <BentoItem
    class="col-span-1 sm:col-span-2 lg:col-span-6"
    title="Tour Bike"
    delay={0}
    href={translatePath("tour-bike-destinations")}>
    <div
      slot="image"
      class="absolute inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-105"
      style="background-image: url('/cycle-tour/leisure.webp')">
    </div>
  </BentoItem>

  <BentoItem
    class="col-span-1 sm:col-span-2 lg:col-span-4"
    title="MTB"
    delay={120}
    href={translatePath("mtb-destinations")}>
    <div
      slot="image"
      class="absolute inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-105"
      style="background-image: url('/cycle-tour/montainbike.webp')">
    </div>
  </BentoItem>

  <BentoItem
    class="col-span-1 sm:col-span-2 lg:col-span-4"
    title="Road Bike"
    delay={240}
    href={translatePath("road-bike")}>
    <div
      slot="image"
      class="absolute inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-105"
      style="background-image: url('/cycle-tour/roadbike.webp')">
    </div>
  </BentoItem>
  <BentoItem
    class="col-span-1 sm:col-span-2 lg:col-span-6"
    title="Bikepack"
    delay={360}
    href={translatePath("bikepack")}>
    <div
      slot="image"
      class="absolute inset-0 z-0 h-full w-full bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out motion-reduce:transition-none group-hover:scale-105"
      style="background-image: url('/cycle-tour/bikepack.webp')">
    </div>
  </BentoItem>
</section>
