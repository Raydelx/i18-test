<button
  type="button"
  data-granada-experiences-open
  class="flex min-h-12 w-full items-center justify-center rounded-lg border-2 border-transparent bg-[#ff5e00] px-5 py-3 text-lg font-bold text-white shadow-lg shadow-[#ff5e00]/25 transition-colors hover:bg-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3c5546]">
  Extra Activities
</button>

<dialog
  data-granada-experiences-dialog
  aria-labelledby="granada-experiences-title"
  class="m-auto max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-5xl overflow-hidden rounded-lg border-0 bg-white p-0 text-[#233229] shadow-2xl backdrop:bg-black/60">
  <div class="flex max-h-[calc(100vh-2rem)] flex-col">
    <header
      class="flex items-start justify-between gap-4 bg-[#3c5546] px-5 py-4 text-white sm:px-8">
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-[#ffbe8f]">
          Cycle Tour Granada
        </p>
        <h2
          id="granada-experiences-title"
          class="mt-1 text-2xl font-bold sm:text-3xl">
          Extra Activities
        </h2>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="rounded-lg border border-white/60 px-3 py-2 text-sm font-bold transition-colors hover:bg-white hover:text-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff5e00]">
          Close
        </button>
      </form>
    </header>

    <div class="overflow-y-auto px-5 py-6 sm:px-8 sm:py-8">
      <div class="grid gap-5">
        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">
            Alhambra Palace &amp; Nasrid Palaces Visit
          </h3>
          <p class="mt-3 leading-relaxed">
            Discover the magnificent Alhambra, Granada’s most iconic monument
            and a UNESCO World Heritage Site. Explore the extraordinary
            architecture of the Nasrid Palaces, the historic Alcazaba fortress
            and the beautiful Generalife Palace and gardens. This unforgettable
            cultural experience offers a fascinating insight into the history
            of Al-Andalus and is the perfect complement to your Sierra Nevada
            E-MTB adventure.
          </p>
          <dl
            class="mt-4 grid gap-2 border-t border-[#3c5546]/15 pt-4 text-sm sm:grid-cols-2">
            <div><dt class="font-bold text-[#3c5546]">Place</dt><dd>Granada</dd></div>
            <div>
              <dt class="font-bold text-[#3c5546]">Reservation</dt>
              <dd>Advance booking required</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Price</dt>
              <dd>EUR 30 per person (standard general admission ticket, without a guide)</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Duration</dt>
              <dd>Approximately 3 hours</dd>
            </div>
          </dl>
          <div class="mt-4 grid gap-4 text-sm leading-relaxed sm:grid-cols-2">
            <div>
              <p class="font-bold text-[#3c5546]">Included</p>
              <ul class="mt-1 list-disc space-y-1 pl-5">
                <li>Admission to the Nasrid Palaces</li>
                <li>Access to the Alcazaba fortress</li>
                <li>Admission to the Generalife Palace and gardens</li>
              </ul>
            </div>
            <div>
              <p class="font-bold text-[#3c5546]">Not Included</p>
              <ul class="mt-1 list-disc space-y-1 pl-5">
                <li>Transport to and from the Alhambra</li>
                <li>Guided tour</li>
                <li>Meals and drinks</li>
              </ul>
            </div>
          </div>
          <div class="mt-4 text-sm leading-relaxed">
            <p class="font-bold text-[#3c5546]">Important Information</p>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              <li>Entry to the Nasrid Palaces is at a specific time indicated on your ticket.</li>
              <li>Advance booking is strongly recommended due to limited availability.</li>
              <li>Visitors must bring their original passport or official identification document.</li>
            </ul>
          </div>
        </article>

        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">
            Flamenco Show at Cuevas Los Tarantos
          </h3>
          <p class="mt-3 leading-relaxed">
            Experience the passion and emotion of traditional Andalusian
            flamenco in the heart of Granada’s historic Sacromonte
            neighbourhood. At Cuevas Los Tarantos, a traditional cave venue
            founded in 1972, you’ll enjoy an authentic Zambra Gitana
            performance, a style of flamenco deeply rooted in Granada’s Romani
            culture. Be captivated by the powerful singing, guitar playing and
            expressive dancing in the intimate atmosphere of a traditional
            cave. A memorable evening and a wonderful opportunity to discover
            one of Andalusia’s most treasured cultural traditions.
          </p>
          <dl
            class="mt-4 grid gap-2 border-t border-[#3c5546]/15 pt-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-bold text-[#3c5546]">Place</dt>
              <dd>Granada – Sacromonte</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Reservation</dt>
              <dd>Advance booking required</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Price</dt>
              <dd>EUR 28 per person (flamenco show with one drink included)</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Duration</dt>
              <dd>Approximately 1 hour</dd>
            </div>
          </dl>
          <div class="mt-4 grid gap-4 text-sm leading-relaxed sm:grid-cols-2">
            <div>
              <p class="font-bold text-[#3c5546]">Included</p>
              <ul class="mt-1 list-disc space-y-1 pl-5"><li>One drink</li></ul>
            </div>
            <div>
              <p class="font-bold text-[#3c5546]">Not Included</p>
              <ul class="mt-1 list-disc space-y-1 pl-5">
                <li>Transport to and from the venue</li>
                <li>Additional food and drinks</li>
              </ul>
            </div>
          </div>
          <div class="mt-4 text-sm leading-relaxed">
            <p class="font-bold text-[#3c5546]">Important Information</p>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              <li>The performance takes place in a traditional cave venue in the Sacromonte neighbourhood.</li>
              <li>Advance booking is recommended.</li>
            </ul>
          </div>
        </article>

        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">
            Hammam Al Ándalus – Arab Baths &amp; Relaxation
          </h3>
          <p class="mt-3 leading-relaxed">
            Relax in traditional Arab baths inspired by the bathing culture of
            Al-Andalus. Enjoy pools at different temperatures, steam and a
            peaceful atmosphere. A perfect way to recover after several days of
            cycling.
          </p>
          <dl
            class="mt-4 grid gap-2 border-t border-[#3c5546]/15 pt-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-bold text-[#3c5546]">Duration</dt>
              <dd>Approximately 1.5 hours</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Reservation</dt>
              <dd>Required</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="font-bold text-[#3c5546]">Price</dt>
              <dd>
                Prices vary depending on the experience and treatments
                selected, including optional massage packages. Please contact
                us by email with your preferences, and we will provide you with
                a personalised quotation.
              </dd>
            </div>
          </dl>
        </article>

        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">
            Granada Tapas &amp; Gastronomy Tour
          </h3>
          <p class="mt-3 leading-relaxed">
            Discover Granada through its food culture. Visit traditional tapas
            bars, taste local specialities and Andalusian wines, and learn about
            the city’s famous tradition of serving complimentary tapas with
            drinks.
          </p>
          <dl
            class="mt-4 grid gap-2 border-t border-[#3c5546]/15 pt-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-bold text-[#3c5546]">Duration</dt>
              <dd>Approximately 2–3 hours</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Reservation</dt>
              <dd>Advance booking required</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="font-bold text-[#3c5546]">Price</dt>
              <dd>
                Depends on the number of participants. Please contact us for a
                personalised quotation.
              </dd>
            </div>
          </dl>
        </article>

        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">
            Guided Walking Tour – Albaicín &amp; Sacromonte
          </h3>
          <p class="mt-3 leading-relaxed">
            Discover Granada’s oldest neighbourhoods with a local guide. Walk
            through narrow Moorish streets, traditional squares and viewpoints
            overlooking the Alhambra. Learn about the city’s history and the
            cave-dwelling traditions of Sacromonte.
          </p>
          <dl
            class="mt-4 grid gap-2 border-t border-[#3c5546]/15 pt-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-bold text-[#3c5546]">Duration</dt>
              <dd>Approximately 2 hours</dd>
            </div>
            <div>
              <dt class="font-bold text-[#3c5546]">Reservation</dt>
              <dd>Advance booking required</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="font-bold text-[#3c5546]">Price</dt>
              <dd>
                Depends on the number of participants. Please contact us for a
                personalised quotation.
              </dd>
            </div>
          </dl>
        </article>
      </div>
    </div>
  </div>
</dialog>

<script>
  const openButton = document.querySelector<HTMLButtonElement>(
    "[data-granada-experiences-open]",
  );
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-granada-experiences-dialog]",
  );

  openButton?.addEventListener("click", () => dialog?.showModal());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });
</script>
