---
import Card from "./card.astro";

interface CardItem {
  name: string;
  href: string;
  description: string;
  description2?: string;
  href_img: string;
  alt_img: string;
}

interface Props {
  items: CardItem[];
  speed?: number;
}

const { items, speed = 24 } = Astro.props;
const duplicatedItems = [...items, ...items];
---

<div class="relative w-full overflow-hidden py-4">
  <div
    class="carousel-track flex w-max items-stretch will-change-transform"
    style={`--duration: ${speed}s`}>
    {
      duplicatedItems.map((item, index) => (
        <div class="w-[380px] flex-shrink-0 px-8 md:w-[440px]">
          <Card {...item} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .carousel-track {
    animation: scroll var(--duration) linear infinite;
    animation-play-state: running;
    padding-top: 8rem;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @media (min-width: 768px) {
    .carousel-track {
      padding-top: 6rem;
    }
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
