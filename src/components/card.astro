---
interface Props {
  name: string;
  href: string;
  description: string;
  description2?: string;
  badge?: string;
  href_img: string;
  alt_img: string;
}

const { name, description, description2, badge, href_img, alt_img, href } =
  Astro.props;

import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<article
  class="group relative flex h-full w-full flex-col overflow-hidden rounded-2xl border border-[#3c5546]/10 bg-white shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl">
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-[#3c5546]/10">
    <img
      src={href_img}
      class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
      alt={alt_img}
      loading="lazy"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#1d2b23]/60 via-transparent to-transparent">
    </div>
    {
      badge && (
        <span class="absolute left-4 top-4 rounded-full bg-[#ff5e00] px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-lg">
          {badge}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 h-1 w-12 rounded-full bg-[#ff5e00]"></div>
    <h3
      class="line-clamp-3 min-h-[2.75em] text-balance text-xl font-bold leading-snug text-[#3c5546] md:text-2xl">
      {name}
    </h3>
    <p class="mt-3 leading-relaxed text-gray-600">{description}</p>
    {description2 && <p class="mt-3 leading-relaxed text-gray-600">{description2}</p>}

    <div class="mt-auto pt-6">
      <a
        href={href}
        rel="noopener"
        class="inline-flex items-center gap-2 font-bold text-[#ff5e00] transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff5e00]">
        {i18n.MORE_INFO}
        <svg
          class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</article>
