          {i18n.CARDS_HOME.CARD_4.WHAT_DO_WE_EXPECT_4}
        </p>
        <p
          class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
          {i18n.CARDS_HOME.CARD_4.WHAT_DO_WE_EXPECT_5}
        </p>
      </div>

      <div>
