            </div>
          </div>
          <button
            type="button"
            class="showMoreBtn mb-6 px-4 py-2 bg-[#3c5546] text-white rounded hover:bg-[#4f6658] transition cursor-pointer">
            {i18n.CARDS_HOME.SHOW_MORE}
          </button>
        </div>
        <div class="mt-12 sm:mt-2 lg:mt-0 order-first lg:order-none">
          <div
            class="-ml-48 pr-6 md:-ml-16 lg:relative lg:m-0 lg:h-full lg:px-0">
            <img
              alt="Inbox user interface"
              loading="lazy"
              width="800"
              height="486"
              class="w-full rounded-xl shadow-xl ring-1 ring-black ring-opacity-5 lg:absolute lg:right-0 lg:h-full lg:w-[540px] lg:max-w-none hover:scale-105 duration-200 object-cover mb-6"
