          {i18n.CARDS_HOME.SHOW_MORE}
        </button>
      </div>
      <div class="mt-12 sm:mt-16 lg:mt-0 order-first lg:order-none">
        <div
          class="-ml-48 pr-6 md:-ml-16 lg:relative lg:m-0 lg:h-full lg:px-0 order-first lg:order-none">
          <img
            alt="Inbox user interface"
            loading="lazy"
            width="800"
            height="486"
            class="w-full rounded-xl shadow-xl ring-1 ring-black ring-opacity-5 object-cover lg:absolute lg:right-0 lg:h-full lg:w-[540px] lg:max-w-none hover:scale-105 duration-200"
            style="color:transparent"
            src="/home/hiking.webp"
          />
        </div>
      </div>
    </div>
    <div
      class="showMoreContent grid lg:grid-cols-3 gap-8 lg:gap-30 mt-16 lg:px-34 transition-all duration-500 ease-in-out overflow-hidden max-h-0 opacity-0 bg-gradient-to-r from-slate-200 to-[#B1BBB5] rounded-2xl py-6 px-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight mb-2">
          {i18n.CARDS_HOME.CARD_4.WHAT_DO_WE_EXPECT}
        </h2>
        <p
          class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
          {i18n.CARDS_HOME.CARD_4.WHAT_DO_WE_EXPECT_1}
        </p>
        <p
          class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
          {i18n.CARDS_HOME.CARD_4.WHAT_DO_WE_EXPECT_2}
        </p>
        <p
          class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
