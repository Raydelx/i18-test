    </div>
  </div>

  <div class="relative overflow-hidden mt-6 lg:mt-16">
    <div
      class="lg:mx-auto grid lg:max-w-7xl lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8">
      <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-0">
        <div>
          <div>
            <img
              class="h-36 object-cover"
              src="/tailor.webp"
              alt="tailor photo"
            />
          </div>

          <div class="mt-6">
            <h2 class="text-3xl font-bold tracking-tight mb-2">
              {i18n.CARDS_HOME.CARD_5.TITLE}
            </h2>
            <h2 class="text-3xl font-bold tracking-tight mb-2">
              {i18n.CARDS_HOME.CARD_5.SUBTITLE}
            </h2>
            <p
              class="max-w-2xl mb-6 font-light text-gray-500 lg:mb-8 md:text-lg lg:text-xl">
              {i18n.CARDS_HOME.CARD_5.TEXT_1}
            </p>
            <p
              class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
              {i18n.CARDS_HOME.CARD_5.TEXT_2}
            </p>
            <p
              class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
              {i18n.CARDS_HOME.CARD_5.TEXT_3}
            </p>
            <p
              class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
              {i18n.CARDS_HOME.CARD_5.TEXT_4}
            </p>
            <p
              class="max-w-2xl mb-4 mt-8 font-semibold text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
              {i18n.CARDS_HOME.CARD_5.TEXT_5}
            </p>
            <p
              class="max-w-2xl mb-4 font-light text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
              {i18n.CARDS_HOME.CARD_5.TEXT_6}
            </p>
          </div>
        </div>
      </div>
      <div class="mt-12 sm:mt-16 lg:mt-16">
        <div class="-mr-48 pl-6 md:-mr-16 lg:relative lg:m-0 lg:h-full lg:px-0">
          <img
            loading="lazy"
            width="647"
            height="300"
            class="w-full rounded-xl shadow-2xl ring-1 object-cover ring-black ring-opacity-5 lg:absolute lg:left-0 lg:h-full lg:w-[540px] lg:max-w-none hover:scale-105 duration-200"
            style="color:transparent"
            src="/home/tailor-made.webp"
          />
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    const buttons = document.querySelectorAll(".showMoreBtn");
    const contents = document.querySelectorAll(".showMoreContent");
    buttons.forEach((btn, idx) => {
      let show = false;
      btn.addEventListener("click", () => {
        show = !show;
        const content = contents[idx];
        if (show) {
          content.classList.remove("max-h-0", "opacity-0");
          content.classList.add("max-h-[2000px]", "opacity-100");
          btn.textContent = "Less info ⬆";
        } else {
          content.classList.remove("max-h-[2000px]", "opacity-100");
          content.classList.add("max-h-0", "opacity-0");
          btn.textContent = "More info ⬇";
        }
      });
    });
  </script>
</div>
