            - {i18n.CARDS_HOME.CARD_3.RENTAL_6}
          </p>
          <p
            class="max-w-2xl mb-4 font-semibold text-gray-500 lg:mb-2 md:text-lg lg:text-xl">
            {i18n.CARDS_HOME.CARD_3.RENTAL_7}
          </p>
        </div>
