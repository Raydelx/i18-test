---
import Icon from "../components/Icon.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div class="relative overflow-hidden">
  <div class="relative overflow-hidden lg:mt-16">
    <div class="relative">
      <div
        class="lg:mx-auto grid lg:grid lg:max-w-7xl lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8">
        <div
          class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-0 lg:col-start-2">
          <div>
            <div>
              <img
                class="h-36 -ml-6 object-cover"
                src="/family.webp"
                alt="family photo"
              />
            </div>
            <div class="mt-2">
              <h2 class="text-3xl font-bold tracking-tight mb-2">
                {i18n.CARDS_HOME.CARD_2.TITLE}
              </h2>
              <h2 class="text-3xl font-bold tracking-tight mb-2">
                {i18n.CARDS_HOME.CARD_2.SUBTITLE}
              </h2>
              <p
                class="max-w-2xl mb-6 font-light text-gray-500 lg:mb-8 md:text-lg lg:text-xl">
                {i18n.CARDS_HOME.CARD_2.TEXT_1}
              </p>
              <p
                class="max-w-2xl mb-6 font-light text-gray-500 lg:mb-8 md:text-lg lg:text-xl">
                {i18n.CARDS_HOME.CARD_2.TEXT_2}
