  </div>

  <div class="relative lg:mt-8">
    <div
      class="lg:mx-auto grid lg:max-w-7xl lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8">
      <div
        class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-0 lg:col-start-2">
        <div>
          <div>
            <img
              class="h-36 object-cover"
              src="/hiking.webp"
              alt="hiking photo"
            />
          </div>
          <div class="mt-2">
            <h2 class="text-3xl font-bold tracking-tight mb-2">
