---
import Icon from "../components/Icon.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div class="relative overflow-hidden">
  <div
    class="lg:mx-auto lg:grid lg:max-w-7xl lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8">
    <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-0">
      <div>
        <div class="mt-6">
          <h2 class="text-3xl font-bold tracking-tight mb-2">
            {i18n.CARDS_HOME.CARD_1.TITLE}
          </h2>

          <p
            class="max-w-2xl mb-6 font-light text-gray-500 lg:mb-8 md:text-lg lg:text-xl">
            {i18n.CARDS_HOME.CARD_1.TEXT_1}
          </p>
        </div>
      </div>
    </div>
    <div class="mt-12 sm:mt-16 lg:mt-0">
      <div class="-mr-48 pl-6 md:-mr-16 lg:relative lg:m-0 lg:h-full lg:px-0">
        <img
          loading="lazy"
          width="647"
          height="300"
          class="w-full rounded-xl shadow-2xl ring-1 ring-black ring-opacity-5 lg:absolute lg:left-0 lg:h-full lg:w-[540px] lg:max-w-none hover:scale-105 duration-200 object-cover"
          style="color:transparent"
          src="/home/montaraz.webp"
        />
      </div>
    </div>
  </div>

