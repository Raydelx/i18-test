---
interface Props {
  class?: string;
  title: string;
  subtitle?: string;
  subtitle2?: string;
  subtitle3?: string;
}

const { class: className, title, subtitle, subtitle2, subtitle3 } = Astro.props;
---

<div
  class:list={[
    "product-info-card group relative h-full min-w-0 overflow-hidden rounded-2xl border border-[#3c5546]/10 bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg",
    className,
  ]}>
  <span
    aria-hidden="true"
    class="absolute inset-y-4 left-0 w-1 rounded-r-full bg-[#ff5e00] opacity-70 transition-all duration-200 group-hover:inset-y-2 group-hover:opacity-100">
  </span>
  <div class="flex h-full min-w-0 items-start gap-3 p-3 sm:p-4">
    <div
      class="grid size-10 shrink-0 place-items-center rounded-xl bg-[#fff1e8] [&_svg]:max-h-7 [&_svg]:max-w-7">
      <slot name="icon" />
    </div>
    <div class="min-w-0 flex-1">
      <p
        class="product-info-card__title text-xs font-bold uppercase tracking-[0.12em] text-[#64736a]">
        {title}
      </p>
      <div
        class="mt-1 flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-0.5">
        {
          subtitle && (
            <p class="product-info-card__value min-w-0 max-w-full break-words text-base font-bold leading-snug text-[#263b30] [overflow-wrap:anywhere]">
              {subtitle}
            </p>
          )
        }
        {
          subtitle2 && (
            <p class="product-info-card__value min-w-0 max-w-full break-words text-base font-bold leading-snug text-[#263b30] [overflow-wrap:anywhere]">
              {subtitle2}
            </p>
          )
        }
      </div>
      {
        subtitle3 && (
          <div class="mt-2 flex min-w-0 items-start gap-2 border-t border-[#3c5546]/10 pt-2">
            <div class="grid size-7 shrink-0 place-items-center rounded-lg bg-[#fff1e8] [&_svg]:max-h-5 [&_svg]:max-w-5">
              <slot name="icon" />
            </div>
            <p class="product-info-card__value min-w-0 break-words text-sm font-semibold leading-snug text-[#3c5546] [overflow-wrap:anywhere]">
              {subtitle3}
            </p>
          </div>
        )
      }
    </div>
  </div>
</div>
