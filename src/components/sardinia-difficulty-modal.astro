<button
  type="button"
  data-sardinia-difficulty-open
  class="flex min-h-12 w-full items-center justify-center rounded-lg border-2 border-transparent bg-[#ff5e00] px-5 py-3 text-lg font-bold text-white shadow-lg shadow-[#ff5e00]/25 transition-colors hover:bg-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3c5546]">
  Difficulty Levels
</button>

<dialog
  data-sardinia-difficulty-dialog
  aria-labelledby="sardinia-difficulty-title"
  class="m-auto max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-5xl overflow-hidden rounded-lg border-0 bg-white p-0 text-[#233229] shadow-2xl backdrop:bg-black/60">
  <div class="flex max-h-[calc(100vh-2rem)] flex-col">
    <header
      class="flex items-start justify-between gap-4 bg-[#3c5546] px-5 py-4 text-white sm:px-8">
      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-[#ffbe8f]">
          Cycle Tour Sardinia
        </p>
        <h2
          id="sardinia-difficulty-title"
          class="mt-1 text-2xl font-bold sm:text-3xl">
          Difficulty Levels
        </h2>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="rounded-lg border border-white/60 px-3 py-2 text-sm font-bold transition-colors hover:bg-white hover:text-[#3c5546] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff5e00]">
          Close
        </button>
      </form>
    </header>

    <div class="overflow-y-auto px-5 py-6 sm:px-8 sm:py-8">
      <div class="max-w-3xl space-y-4 text-base leading-relaxed text-[#4d5c52]">
        <p>
          Our e-bike tours are specially designed for recreational cyclists who
          enjoy discovering the region at a relaxed pace. These tours focus on
          enjoying the landscape, cultural heritage, and history of the area.
        </p>
        <p>
          Thanks to electric assistance, these routes are accessible to almost
          everyone with a basic level of fitness. However, we divide the tours
          into three difficulty levels based on distance and elevation gain.
        </p>
        <p>
          While the e-bike takes much of the physical effort out of cycling,
          longer distances or greater elevation can still make for a more
          challenging ride.
        </p>
        <p>
          To participate in these cycling holidays, it is important that you
          have a good basic fitness level, cycle regularly, and are comfortable
          shifting gears efficiently when climbing or descending. This will
          greatly enhance your enjoyment on the road.
        </p>
        <p>
          Below is a simple breakdown of the three difficulty levels, so you can
          choose a route that suits your experience and fitness level.
        </p>
      </div>

      <div class="mt-6 grid gap-5">
        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">Level 1</h3>
          <ul class="mt-3 space-y-1 leading-relaxed">
            <li><span class="font-bold">Distance:</span> Around 45 km</li>
            <li><span class="font-bold">Elevation gain:</span> Minimal</li>
            <li>
              <span class="font-bold">Terrain:</span> Flat to gently rolling
            </li>
            <li>
              <span class="font-bold">Requirements:</span> No specific experience
              needed
            </li>
          </ul>
        </article>

        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">Level 2</h3>
          <ul class="mt-3 space-y-1 leading-relaxed">
            <li><span class="font-bold">Distance:</span> 35-60 km</li>
            <li>
              <span class="font-bold">Elevation gain:</span> Approximately 800 metres
            </li>
            <li>
              <span class="font-bold">Terrain:</span> Gently rolling to moderate climbs,
              with occasional steep sections
            </li>
            <li>
              <span class="font-bold">Requirements:</span> Regular cyclist, comfortable
              using an e-bike
            </li>
          </ul>
        </article>

        <article
          class="border border-[#3c5546]/20 border-l-4 border-l-[#ff5e00] p-5">
          <h3 class="text-xl font-bold text-[#3c5546]">Level 3</h3>
          <ul class="mt-3 space-y-1 leading-relaxed">
            <li><span class="font-bold">Distance:</span> 60+ km</li>
            <li>
              <span class="font-bold">Elevation gain:</span> 1,000+ metres
            </li>
            <li>
              <span class="font-bold">Terrain:</span> Hilly to mountainous, with longer
              descents
            </li>
            <li>
              <span class="font-bold">Requirements:</span> Good fitness, experience
              with longer rides, and confident gear shifting
            </li>
          </ul>
        </article>
      </div>
    </div>
  </div>
</dialog>

<script>
  const openButton = document.querySelector<HTMLButtonElement>(
    "[data-sardinia-difficulty-open]",
  );
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-sardinia-difficulty-dialog]",
  );

  openButton?.addEventListener("click", () => dialog?.showModal());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });
</script>
