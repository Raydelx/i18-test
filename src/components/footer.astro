---
import Icon from "./Icon.astro";
import Container from "../components/container.astro";

import { getLangFromUrl, useTranslatedPath } from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<svg
  id="wave"
  style="transform:rotate(0deg); transition: 0.3s"
  viewBox="0 0 1440 100"
  version="1.1"
  class="pt-20"
  xmlns="http://www.w3.org/2000/svg"
  ><defs
    ><linearGradient id="sw-gradient-0" x1="0" x2="0" y1="1" y2="0"
      ><stop stop-color="rgba(60, 85, 70, 1)" offset="0%"></stop><stop
        stop-color="rgba(60, 85, 70, 1)"
        offset="100%"></stop></linearGradient
    ></defs
  ><path
    style="transform:translate(0, 0px); opacity:1"
    fill="url(#sw-gradient-0)"
    d="M0,90L205.7,20L411.4,90L617.1,70L822.9,30L1028.6,40L1234.3,80L1440,90L1645.7,10L1851.4,90L2057.1,80L2262.9,30L2468.6,60L2674.3,10L2880,0L3085.7,0L3291.4,30L3497.1,20L3702.9,80L3908.6,80L4114.3,40L4320,50L4525.7,20L4731.4,10L4937.1,80L4937.1,100L4731.4,100L4525.7,100L4320,100L4114.3,100L3908.6,100L3702.9,100L3497.1,100L3291.4,100L3085.7,100L2880,100L2674.3,100L2468.6,100L2262.9,100L2057.1,100L1851.4,100L1645.7,100L1440,100L1234.3,100L1028.6,100L822.9,100L617.1,100L411.4,100L205.7,100L0,100Z"
  ></path><defs
    ><linearGradient id="sw-gradient-1" x1="0" x2="0" y1="1" y2="0"
      ><stop stop-color="rgba(60, 85, 70, 1)" offset="0%"></stop><stop
        stop-color="rgba(60, 85, 70, 1)"
        offset="100%"></stop></linearGradient
    ></defs
  ><path
    style="transform:translate(0, 50px); opacity:0.9"
    fill="url(#sw-gradient-1)"
    d="M0,50L205.7,0L411.4,10L617.1,70L822.9,10L1028.6,60L1234.3,40L1440,10L1645.7,70L1851.4,10L2057.1,70L2262.9,0L2468.6,90L2674.3,50L2880,40L3085.7,40L3291.4,30L3497.1,60L3702.9,10L3908.6,70L4114.3,0L4320,60L4525.7,30L4731.4,70L4937.1,50L4937.1,100L4731.4,100L4525.7,100L4320,100L4114.3,100L3908.6,100L3702.9,100L3497.1,100L3291.4,100L3085.7,100L2880,100L2674.3,100L2468.6,100L2262.9,100L2057.1,100L1851.4,100L1645.7,100L1440,100L1234.3,100L1028.6,100L822.9,100L617.1,100L411.4,100L205.7,100L0,100Z"
  ></path></svg
>
<footer class="pb-16 pt-10 bg-[#3c5546] w-full -mt-1">
  <Container>
    <div class="flex flex-col md:flex-row justify-between relative">
      <div class="grid gap-2">
        <img
          src="/logo-new.svg"
          class="w-90 h-20 brightness-0 invert"
          alt="logo montaraz outdoors & culture"
        />
        <div class="grid mx-2">
          <a
            href="https://www.instagram.com/montaraz_outdoors_culture/"
            target="_blank"
            class="flex place-items-center gap-2 hover:opacity-50 text-gray-100"
            ><Icon icon="instagram-logo" size="1.5rem" color="white" />
            montaraz_outdoors_culture</a
          >
        </div>
        <div class="grid mx-2">
          <a
            href="mailto:montarazoutdoors@gmail.com"
            target="_blank"
            class="flex place-items-center gap-2 hover:opacity-50 text-gray-100"
            ><Icon icon="mail-logo" size="1.5rem" color="white" />
            montarazoutdoors@gmail.com</a
          >
        </div>
        <div class="grid mx-2">
          <a
            class="flex place-items-center gap-2 hover:opacity-50 cursor-pointer text-gray-100"
            href="https://wa.me/34665311314?text=Hello, welcome to Montaraz Outdoors and Culture! How can we help you?"
            target="_blank"
            class="flex place-items-center gap-2">
            <Icon icon="whatsap-logo" size="1.5rem" color="white" />
            (+34) 665 311 314
          </a>
        </div>
        <div class="grid mx-2">
          <a
            class="flex place-items-center gap-2 text-gray-100"
            href=""
            target="_blank"
            class="flex place-items-center gap-2">
            <Icon icon="agency-logo" size="1.5rem" color="white" />
            Agencia de Viajes - Nº C.I.AN-188135-3
          </a>
        </div>
      </div>
      <div class="grid lg:mt-7 gap-2 px-2 mt-8 md:mt-0">
        <h2 class="text-xl font-semibold text-gray-100">Quick Links</h2>
        <a
          href={translatePath("legal-notice")}
          class="hover:opacity-50 text-gray-100">Legal Notice</a
        >
        <a
          href={translatePath("privacy-policy")}
          class="hover:opacity-50 text-gray-100">Privacy Policy</a
        >
        <a
          href={translatePath("cookie-policy")}
          class="hover:opacity-50 text-gray-100">Cookie Policy</a
        >
        <a
          href={translatePath("terms-and-conditions")}
          class="hover:opacity-50 text-gray-100"
          >Terms and Conditions
        </a>
        <a
          href={translatePath("financial-protection-guarantee")}
          class="hover:opacity-50 text-gray-100"
          >Financial Protection Guarantee
        </a>
        <a
          href={translatePath("personal-data-protection")}
          class="hover:opacity-50 text-gray-100"
          >Personal Data Protection
        </a>
      </div>
    </div>
  </Container>
</footer>
