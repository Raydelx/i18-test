---
import Icon from "../components/Icon.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div
  class="m-auto grid lg:grid w-full lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8 bg-center bg-no-repeat bg-[url('/bg_montaraz.webp')] bg-cover lg:h-[32rem]">
  <div
    class="mx-auto max-w-xl lg:mx-0 lg:max-w-none lg:py-16 lg:px-10 p-4 flex flex-col justify-center h-full">
    <div class="p-6 flex flex-col justify-center h-full">
      <div
        class="mt-6 flex flex-col justify-center items-center lg:items-center text-center">
        <h2 class="text-3xl font-bold tracking-tight mb-2 text-white">
          {i18n.CARDS_HOME.CARD_1.TITLE}
        </h2>
        <p
          class="max-w-2xl mb-6 font-light text-white lg:mb-8 md:text-lg lg:text-xl">
          {i18n.CARDS_HOME.CARD_1.TEXT_1}
        </p>
      </div>
    </div>
  </div>
  <div
    class="mt-12 sm:mt-2 lg:mt-0 order-first lg:order-none p-6 flex justify-center items-center">
    <div
      class="relative w-full max-w-xs sm:max-w-xs md:max-w-sm lg:max-w-none lg:h-full lg:px-0 flex justify-center">
      <img
        loading="lazy"
        class="rounded-xl shadow-2xl ring-1 ring-black ring-opacity-5 border-4 border-white object-fit w-60 h-60 sm:w-64 sm:h-48 md:w-80 md:h-60 lg:w-[500px] lg:h-full"
        style="color:transparent"
        src="/home/montaraz.webp"
        alt="Montaraz"
      />
    </div>
  </div>
</div>
