---

<Layout title="Gallery">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Cycle Ronda Cordoba</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>

    <div class="mt-16">
      <div
        class="pswp-gallery grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6 md:gap-6 object-fill"
        id="gallery">
        {
          images.map((image) => (
            <a
              class="object-cover"
              href={image.src}
              data-cropped="true"
              data-pswp-width={image.width}
              data-pswp-height={image.height}
              target="_blank">
              <img
                class="w-full md:h-64 md:w-72 md:size-64 object-cover rounded-xl hover:scale-105 duration-200 transition-all"
                src={image.thumb}
                alt={image.alt}
              />
            </a>
          ))
        }
      </div>
    </div>

    <script>
      import PhotoSwipeLightbox from "photoswipe/lightbox";

      const lightbox = new PhotoSwipeLightbox({
        gallery: "#gallery",
        children: "a",
        pswpModule: () => import("photoswipe"),
      });
      lightbox.init();
    </script>
  </Container>
</Layout>
