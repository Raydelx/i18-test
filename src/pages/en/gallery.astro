---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import GalleryFull from "../../components/galleryFull.astro";
import SearchableProductsGrid from "../../components/searchable-products-grid.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const products = [
  {
    title: "Cycle Ronda Cordoba",
    href: translatePath("gallery-cycle-ronda"),
    image: "/gallery/img-1.webp",
    alt: "Cycle Ronda Cordoba image",
  },
];
---

<Layout title="Gallery">
  <Container>
    <Sectionhead class="">
      <Fragment slot="title">Gallery</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <div class="mt-10"><SearchableProductsGrid products={products} /></div>
  </Container>
</Layout>
