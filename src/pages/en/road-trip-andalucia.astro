---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import Card from "../../components/card.astro";

import { getI18N } from "@/i18n/";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@/i18n/utils.js";

const lang = getLangFromUrl(Astro.url);

const translatePath = useTranslatedPath(lang);

const TOURBIKEPRODUCTS = [
  {
    name: "Road Trip Andalucia",
    description: "",
    href: translatePath("roadtrip-andalucia"),
    href_img: "/roadtrips/andalucia/roadtrip-andalucia/rta-product.webp",
    alt_img: "Road Trip Andalucia",
  },
];
---

<Layout title="E-Bike Products">
  <Container>
    <Sectionhead>
      <Fragment slot="title">RoadTrips Andalucia</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <main class="mt-24">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
        {
          TOURBIKEPRODUCTS.map((tour) => (
            <li class="mb-10 ">
              <Card {...tour} />
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
