---
import Container from "@/components/container.astro";
import InformationProducts from "@/components/ui/informationProducts.astro";
import Icon from "@/components/Icon.astro";
import Layout from "@/layouts/Layout.astro";
import SliderReact from "@/hooks/SliderReact";
import Includes from "@/components/products-components/includes.astro";
import Route from "@/components/ui/icons/route.astro";
import cycleSardiniaNl from "@/data_files/cycleMtbSierraNevadaEs.json";
import { getI18N } from "@/i18n/";
import AccordionProducts from "@/components/accordionProducts.astro";
import BookButton from "@/components/book-button.astro";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

import { Accordion, AccordionItem } from "free-astro-components";

// Duplica y cambia las rutas para añadir o modificar las fotos

const BIKES = [
  {
    src: "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-bike.webp",
  },
];

const IMG = [
  {
    src: "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-1.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-2.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-3.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-4.webp",
  },
  {
    src: "/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-5.webp",
  },
];

type ReviewsProps = {
  header: {
    name: string;
    productName: string;
    valoration: string;
  };
  body: {
    text: string;
  };
};
---

<Layout title="">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-cover bg-no-repeat bg-[url('/public/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-principal.webp')] h-[25rem] lg:h-[45rem] rounded-2xl">
        <div class="flex flex-col justify-end h-full p-6 w-auto">
          <div class="flex gap-2">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              Granada
            </p>
          </div>
          <div>
            <h1
              class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              Sierra Nevada E-BikeTour 8 Days
            </h1>
          </div>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts title={i18n.INFO_PRODUCTS.PRICE} subtitle="1.995">
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle="30%">
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle="">
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle="8 Days">
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle="Guided">
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle2="Spring Autumn">
          <div slot="icon">
            <Icon icon="spring-logo" size="1.6rem" color="#ff5e00" />
            <Icon icon="autumn-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
      </div>

      <!-- Informacion tecnica -->

      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle="324 km">
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle="6.210 m">
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DESCENT}
            subtitle="7.550 m">
            <div slot="icon">
              <Icon icon="down-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.ROUTE_TYPE}
            subtitle="Point-to-point">
            <div slot="icon">
              <Route />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.DIFFICULTY}
            subtitle="S0 - S1">
            <div class="flex gap-1" slot="icon">
              <Icon icon="difficulty-logo" size="2rem" color="#ff5e00" />
            </div>
          </InformationProducts>
          <InformationProducts title="E-Bike" subtitle="Yes">
            <div slot="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="45"
                height="30"
                fill="#ff5e00"
                viewBox="80 90 330 330"
                ><path
                  d="M83.172,319.817Q85.646,320,88.1,320A64,64,0,0,0,136.544,214.29a64.376,64.376,0,0,0-11.981-10.841l9.59-17.982,46.293,46.293A31.986,31.986,0,1,0,235.7,264h20.823a64.023,64.023,0,1,0,42.47-68.439l-10.025-19.605L300.944,152H316a20,20,0,0,0,0-40H276a20,20,0,0,0,0,40h7.053l-8,16H143.469l16.49-30.918L160,137l4.8-9H200a8,8,0,0,0,0-16H166.624A24.039,24.039,0,0,0,144,96H120a8,8,0,0,0-8,8v32a8,8,0,0,0,8,8h18.136l-27.748,52.028a64.045,64.045,0,0,0-86.2,55.141h0A64.072,64.072,0,0,0,83.172,319.817ZM312,256a8,8,0,1,1,8,8A8.009,8.009,0,0,1,312,256Zm-20-38.953L303.183,238.9a24.037,24.037,0,0,0-5.8,9.1h-24.7A48.052,48.052,0,0,1,292.007,217.047Zm-14.122-27.618,6.775,13.25A64.062,64.062,0,0,0,256.521,248H240a31.8,31.8,0,0,0-4.446-16.244ZM260.686,184l-36.443,36.443a31.9,31.9,0,0,0-32.483,0L155.314,184ZM96,256a8,8,0,1,1-8-8A8.009,8.009,0,0,1,96,256Z"
                ></path><path
                  d="M380,168H344v16h36a92,92,0,0,1,0,184H327.324a47.991,47.991,0,0,0-94.642,0H190.99A32.057,32.057,0,0,0,160,344H120a8,8,0,0,0-8,8H96a8,8,0,1,0,0,16h16v16H96a8,8,0,1,0,0,16h16a8,8,0,0,0,8,8h40a32.057,32.057,0,0,0,30.987-24h41.692a47.991,47.991,0,0,0,94.642,0H380a108,108,0,0,0,0-216ZM294.659,380.438l-16,24-13.312-8.876L273.055,384H272a8,8,0,0,1-6.653-12.438l16-24,13.312,8.876L286.951,368H288a8,8,0,0,1,6.656,12.438Z"
                ></path></svg
              >
            </div>
          </InformationProducts>
        </div>
      </div>

      <div class="mt-10 max-w-[320px]">
        <BookButton />
      </div>

      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-2 mt-10 md:mt-16 md:mb-26 gap-16 md:gap-20 wrap">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.INCLUDED
            .TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Professional guides</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Liability insurance and assistance
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Financial Protection Guarantee
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Support vehicles and bike trailers
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Luggage transport</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Airport transfer</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Accommodation including breakfast
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Breakfast: 7 days</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Lunch: 5 picnics</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">E-bike</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">7 x Dinner</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Water bottle</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Cycle t-shirt</p>
            </li>
          </ul>
        </Includes>
        <!-- Exclude -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.NOT_INCLUDED
            .TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex gap-2">
              <div>
                <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              </div>
              <p class="max-w-[320px] text-md">
                Travel & cancellation insurance (It is obligatory to take out
                travel insurance before departure)
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Flight</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Lunch free day</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Helmet</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Extra meals</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Extra excursions</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Personal expenses</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Tips</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Extra nights</p>
            </li>
            <li class="flex gap-2">
              <div>
                <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              </div>
              <p class="max-w-[320px] text-md">
                Private transport after or before the tour
              </p>
            </li>
          </div>
        </Includes>
        <!-- Complementaries -->
      </div>
    </main>

    <div class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 md:py-36 py-10">
      <div class="static h-[385px] hidden md:block">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-2.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[20rem] md:mt-48 lg:mt-40 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-3.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/montainbike/mtb-sierra-nevada-tour-8-days/mt-srnt-4.webp"
          alt="ciclista mirando la sierra con cicicleta a su lado"
        />
      </div>

      <div class="grid gap-5 md:-mt-20">
        <div>
          <h2
            class="max-w-2xl mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-4 rounded-lg">
            {i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.AVAILABILITY}
          </h2>
          <p>
            This tour has no fixed departure dates. Contact us with your
            preferred travel dates, and we'll be happy to arrange a tour that
            fits your schedule.
          </p>
          <div class="gap-4 mt-6">
            <ul class="text-lg">
              <div class="grid lg:grid-cols-2 gap-2 mt-4">
                <div class="flex gap-2">
                  <Icon icon="spring-logo" size="1.6rem" color="#ff5e00" />
                  <p>Spring</p>
                </div>
              </div>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 mt-10 items-center">
      <div>
        <h2
          class="max-w-2xl mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-2 rounded-lg">
          Bicycle
        </h2>
        <p>🔶 e-MTB HARDTAIL T -Tronik X 9.1 800Wh</p>
      </div>
      <div class="w-full overflow-x-auto">
        <ol class="w-full">
          {(<SliderReact IMG={BIKES} client:visible />)}
        </ol>
      </div>
    </div>

    <AccordionProducts
      title="Travel<br />Information"
      cycleSardiniaEs={cycleSardiniaNl}
    />

    <div
      class="grid lg:grid-cols-3 lg:grid-rows-2 gap-8 mb-10 lg:mb-30 lg:mt-20 rounded-2xl">
      <div class="text-center bg-[#3c5546] rounded-xl p-4">
        <h2
          class="max-w-2xl font-bold text-2xl md:text-2xl text-white px-6 py-2 rounded-lg">
          Weather Conditions in Granada (Lower Altitudes)
        </h2>
        <p class="mb-4 px-6 py-2 text-white font-bold">
          Conditions are generally very pleasant, with noticeable temperature
          differences between day and night.
        </p>
        <p class="px-6 py-2 text-white">🔶 Daytime temperatures: 20°C–26°C</p>
        <p class="px-6 py-2 text-white">
          🔶 Night-time temperatures: 10°C–13°C
        </p>
        <p class="px-6 py-2 text-white">🔶 Climate: Mild and mostly sunny</p>
        <p class="px-6 py-2 text-white">
          🔶 Rainfall: Small chance of occasional showers (approximately 5–6
          rainy days per month)
        </p>
      </div>

      <div class="text-center bg-[#3c5546] rounded-xl p-4">
        <h2
          class="max-w-2xl font-bold text-2xl md:text-2xl text-white px-6 py-2 rounded-lg">
          Weather Conditions in Gorafe / Semi-Arid Areas
        </h2>
        <p class="mb-4 px-6 py-2 text-white font-bold">
          The main factors here are heat and strong sun exposure.
        </p>
        <p class="px-6 py-2 text-white">
          🔶 Temperatures are similar to or slightly higher than in Granada.
        </p>
        <p class="px-6 py-2 text-white">
          🔶 The sun makes it feel warmer than the actual temperature.
        </p>
        <p class="px-6 py-2 text-white">
          🔶 Dry climate with very little shade.
        </p>
      </div>

      <div class="text-center bg-[#3c5546] rounded-xl p-4">
        <h2
          class="max-w-2xl font-bold text-2xl md:text-2xl text-white px-6 py-2 rounded-lg">
          Weather Conditions in the Sierra Nevada (1,800–2,000 m)
        </h2>
        <p class="mb-4 px-6 py-2 text-white font-bold">
          At higher elevations, temperatures are considerably lower—often up to
          10°C cooler than in Granada.
        </p>
        <p class="mb-4 px-6 py-2 text-white">Typical conditions include:</p>
        <p class="px-6 py-2 text-white">🔶 Cool mornings</p>
        <p class="px-6 py-2 text-white">🔶 Mild temperatures around midday</p>
        <p class="px-6 py-2 text-white">🔶 Cold descents</p>
        <p class="px-6 py-2 text-white">
          🔶 Daytime temperatures: approximately 10°C–20°C
        </p>
        <p class="px-6 py-2 text-white">🔶 Feels like: Cooler due to wind</p>
        <p class="px-6 py-2 text-white">
          🔶 Weather: Rapid weather changes are possible
        </p>
      </div>
      <div class="text-center bg-[#3c5546] rounded-xl p-4 lg:col-start-2">
        <h2
          class="max-w-2xl font-bold text-2xl md:text-2xl text-white px-6 py-2 rounded-lg">
          Important Considerations
        </h2>
        <p class="mb-4 px-6 py-2 text-white font-bold">
          During the tour, riders may experience:
        </p>

        <p class="px-6 py-2 text-white">
          🔶 Large temperature variations (up to 15°C in a single day)
        </p>
        <p class="px-6 py-2 text-white">
          🔶 Rapid weather changes in the mountains
        </p>
        <p class="px-6 py-2 text-white">🔶 Wind in exposed areas</p>
        <p class="px-6 py-2 text-white">
          🔶 Strong UV radiation, even when temperatures are relatively low
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-4 items-center">
      <div>
        <h2
          class="mb-4 font-bold text-2xl md:text-4xl xl:text-5xl bg-[#3c5546] inline-block text-white px-6 py-4 rounded-lg">
          What to Pack for Your Cycling Holidays
        </h2>
        <p class="mb-2">
          A well-packed bag makes a smoother ride! Here’s what we recommend for
          your cycle tour through Granada.
        </p>
        <p class="font-bold mb-2">Checklist</p>
        <p class="font-bold">Cycling clothing:</p>
        <p>
          🔶 Cycling (padded) shorts and jerseys – 2–3 sets (long and short
          sleeves)
        </p>
        <p>🔶 Lightweight windproof and/or waterproof jacket (rain jacket)</p>
        <p>🔶 Sweater or fleece (extra layers for cooler conditions)</p>
        <p>
          🔶 Padded cycling gloves (spring and autumn mornings can be chilly)
        </p>
        <p>🔶 Arm and leg warmers (optional but very useful)</p>
        <p>🔶 Sports socks (quick-dry) shirts</p>
        <p>🔶 Lightweight thermal base layer</p>
        <p>🔶 Short-finger cycling gloves</p>
        <p>🔶 Full-finger cycling gloves (recommended for mountain stages)</p>
        <p class="mb-2">🔶 Cycling shoes</p>

        <p class="font-bold">Sun & weather protection:</p>
        <p>🔶 Sunhat</p>
        <p>🔶 Neck warmer (buff)</p>
        <p>🔶 Sunglasses</p>
        <p>🔶 Cycling cap or buff (sun protection under the helmet)</p>
        <p>🔶 Sunscreen (high SPF)</p>
        <p class="mb-2">🔶 Lip balm with SPF (recommended)</p>

        <p class="font-bold">Equipment & accessories:</p>
        <p>🔶 Water bottle (provided by us))</p>
        <p>🔶 Bike helmet</p>
        <p>🔶 Gel seat cover for added comfort (optional)</p>
        <p>🔶 Small rucksack</p>
        <p class="mb-2">🔶 GPS device with the provided GPX routes</p>

        <p class="font-bold">Bike Essentials</p>
        <p>🔶 Spare inner tube</p>
        <p>🔶 Mini pump or CO₂ inflator</p>
        <p>🔶 Multi-tool</p>
        <p>🔶 Chain quick link</p>
        <p class="mb-2">🔶 Tubeless repair kit</p>

