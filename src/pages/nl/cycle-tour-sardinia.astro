---
import Container from "@/components/container.astro";
import InformationProducts from "@/components/ui/informationProducts.astro";
import Icon from "@/components/Icon.astro";
import Layout from "@/layouts/Layout.astro";
import SliderReact from "@/hooks/SliderReact";
import Days from "@/components/products-components/days.astro";
import Includes from "@/components/products-components/includes.astro";
import Route from "@/components/ui/icons/route.astro";
import Link from "@/components/ui/link.astro";
import cycleSardiniaNl from "@/data_files/cycleSardiniaNl.json";
import { Accordion, AccordionItem } from "free-astro-components";

import ReviewsCompt from "@/components/ui/reviewsCompt.astro";

import { getI18N } from "@/i18n/";
import NewFaq from "@/components/newFaq.astro";
import AccordionProducts from "@/components/accordionProducts.astro";
import BookButton from "@/components/book-button.astro";
import SardiniaDifficultyModal from "@/components/sardinia-difficulty-modal-nl.astro";
import SardiniaExperiencesModal from "@/components/sardinia-experiences-modal-nl.astro";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// Duplica y cambia las rutas para añadir o modificar las fotos

const BIKES = [
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/bike-1.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/bike-2.webp",
  },
];

const IMG = [
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/sardinia-1.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/sardinia-2.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/sardinia-3.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/sardinia-4.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/sardinia-5.webp",
  },
  {
    src: "/cycle-tour/leisure-cycling/italia/sardinia/sardinia-6.webp",
  },
];

type ReviewsProps = {
  header: {
    name: string;
    productName: string;
    valoration: string;
  };
  body: {
    text: string;
  };
};
---

<Layout title="10-daagse e-biketocht door Sardinië">
  <Container>
    <main class="mt-16">
      <!-- Foto, nombre y destino -->

      <div
        class="bg-center bg-cover bg-no-repeat bg-[url('/public/cycle-tour/leisure-cycling/italia/sardinia/sardinia-principal.webp')] h-[25rem] lg:h-[45rem] rounded-2xl">
        <div class="flex flex-col justify-end h-full p-6 w-auto">
          <div class="flex gap-2">
            <Icon icon="destiny-logo" size="1.6rem" color="white" />
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col justify-end h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              Italië
            </p>
          </div>
          <div>
            <h1
              class="text-3xl font-extrabold tracking-tight leading-none text-white md:text-4xl lg:text-5xl [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
              10-daagse e-biketocht door Sardinië
            </h1>
            <p
              class="text-xl font-normal text-white lg:text-2xl flex flex-col h-full [text-shadow:_0_2px_4px_rgb(0_0_0_/_0.8)]">
            </p>
          </div>
        </div>
      </div>

      <!-- Informacion general de los viajes -->

      <div
        class="grid grid-cols-2 md:grid-cols-6 h-auto mt-3 gap-3 place-content-start md:px-6">
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRICE}
          subtitle="€ 2.810 gedeelde kamer, € 3.185 eenpersoonskamer">
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.PRE_BOOKING}
          subtitle="30%">
          <div slot="icon">
            <Icon icon="price-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.MINIMUM_OF_PERSONS}
          subtitle="10">
          <div slot="icon">
            <Icon icon="group-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.DURATION}
          subtitle="10 dagen">
          <div slot="icon">
            <Icon icon="timer-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.TOUR_TYPE}
          subtitle="Begeleid">
          <div slot="icon">
            <Icon icon="guide-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
        <InformationProducts
          title={i18n.INFO_PRODUCTS.SEASON}
          subtitle2="Lente en herfst">
          <div slot="icon">
            <Icon icon="spring-logo" size="1.6rem" color="#ff5e00" />
            <Icon icon="autumn-logo" size="1.6rem" color="#ff5e00" />
          </div>
        </InformationProducts>
      </div>

      <!-- Informacion tecnica -->

      <div class="">
        <div
          class="grid grid-cols-2 justify-between md:grid-cols-6 h-auto mt-3 gap-3 md:px-6">
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DISTANCE}
            subtitle="373 km">
            <div slot="icon">
              <Icon icon="distance-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>

          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_ASCENT}
            subtitle="4.655 m">
            <div slot="icon">
              <Icon icon="up-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.TOTAL_DESCENT}
            subtitle="5.825 m">
            <div slot="icon">
              <Icon icon="down-logo" size="1.6rem" color="#ff5e00" />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.ROUTE_TYPE}
            subtitle="Van plaats naar plaats">
            <div slot="icon">
              <Route />
            </div>
          </InformationProducts>
          <InformationProducts
            title={i18n.INFO_PRODUCTS.DIFFICULTY}
            subtitle="2-3">
            <div class="flex gap-1" slot="icon">
              <Icon icon="difficulty-logo" size="2rem" color="#ff5e00" />
            </div>
          </InformationProducts>
          <InformationProducts title="E-bike" subtitle="Ja">
            <div slot="icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="45"
                height="30"
                fill="#ff5e00"
                viewBox="80 90 330 330"
                ><path
                  d="M83.172,319.817Q85.646,320,88.1,320A64,64,0,0,0,136.544,214.29a64.376,64.376,0,0,0-11.981-10.841l9.59-17.982,46.293,46.293A31.986,31.986,0,1,0,235.7,264h20.823a64.023,64.023,0,1,0,42.47-68.439l-10.025-19.605L300.944,152H316a20,20,0,0,0,0-40H276a20,20,0,0,0,0,40h7.053l-8,16H143.469l16.49-30.918L160,137l4.8-9H200a8,8,0,0,0,0-16H166.624A24.039,24.039,0,0,0,144,96H120a8,8,0,0,0-8,8v32a8,8,0,0,0,8,8h18.136l-27.748,52.028a64.045,64.045,0,0,0-86.2,55.141h0A64.072,64.072,0,0,0,83.172,319.817ZM312,256a8,8,0,1,1,8,8A8.009,8.009,0,0,1,312,256Zm-20-38.953L303.183,238.9a24.037,24.037,0,0,0-5.8,9.1h-24.7A48.052,48.052,0,0,1,292.007,217.047Zm-14.122-27.618,6.775,13.25A64.062,64.062,0,0,0,256.521,248H240a31.8,31.8,0,0,0-4.446-16.244ZM260.686,184l-36.443,36.443a31.9,31.9,0,0,0-32.483,0L155.314,184ZM96,256a8,8,0,1,1-8-8A8.009,8.009,0,0,1,96,256Z"
                ></path><path
                  d="M380,168H344v16h36a92,92,0,0,1,0,184H327.324a47.991,47.991,0,0,0-94.642,0H190.99A32.057,32.057,0,0,0,160,344H120a8,8,0,0,0-8,8H96a8,8,0,1,0,0,16h16v16H96a8,8,0,1,0,0,16h16a8,8,0,0,0,8,8h40a32.057,32.057,0,0,0,30.987-24h41.692a47.991,47.991,0,0,0,94.642,0H380a108,108,0,0,0,0-216ZM294.659,380.438l-16,24-13.312-8.876L273.055,384H272a8,8,0,0,1-6.653-12.438l16-24,13.312,8.876L286.951,368H288a8,8,0,0,1,6.656,12.438Z"
                ></path></svg
              >
            </div>
          </InformationProducts>
        </div>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3 lg:gap-10">
        <div>
          <BookButton />
        </div>
        <div>
          <SardiniaExperiencesModal />
        </div>
        <div>
          <SardiniaDifficultyModal />
        </div>
      </div>

      <!--  Include, exclude, complementaries  -->
      <div
        class="grid md:grid-cols-2 lg:grid-cols-2 mt-10 md:mt-16 md:mb-26 gap-16 md:gap-20 wrap">
        <!-- Include -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.INCLUDED
            .TITLE}>
          <ul slot="description" class="mt-4 flex flex-col gap-2">
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">              2 professionele gidsen</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Aansprakelijkheidsverzekering en assistentie
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Financiële garantiebescherming
              </p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Volgwagen</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Bagagevervoer</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Luchthaventransfer</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">3- en 4-sterrenhotels</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Privékamer, 9 nachten</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Ontbijt: 9 dagen</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Lunch: 6 picknicks</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">E-bike</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Fietshelm</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Bidon</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="check-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Fietsshirt</p>
            </li>
          </ul>
        </Includes>
        <!-- Exclude -->
        <Includes
          title={i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.NOT_INCLUDED
            .TITLE}>
          <div slot="description" class="flex flex-col gap-2 mt-4">
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="text-md">
                Reis- en annuleringsverzekering (we raden aan vóór vertrek een
                reisverzekering af te sluiten)
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="text-md">Vlucht</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Diner</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Lunch (picknick) op de twee vrije fietsdagen
              </p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Extra maaltijden</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Extra excursies</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Persoonlijke uitgaven</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Fooien</p>
            </li>
            <li class="flex flex-wrap gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">Extra nachten</p>
            </li>
            <li class="flex gap-2">
              <Icon icon="uncheck-logo" size="1.6rem" color="#ff5e00" />
              <p class="max-w-[320px] text-md">
                Privévervoer vóór of na de tour
              </p>
            </li>
          </div>
        </Includes>
        <!-- Complementaries -->
      </div>
    </main>

    <div class="grid md:grid-cols-2 h-auto gap-10 md:gap-20 md:py-36 py-10">
      <div class="static h-[385px] hidden md:block">
        <img
          class="rounded-xl absolute md:w-[20rem] lg:w-[25rem] hover:z-40 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/leisure-cycling/italia/sardinia/sardinia-3.webp"
          alt="Fietser kijkt uit over de bergen met de fiets naast zich"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[12rem] md:mt-48 lg:mt-30 ml-6 z-10 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/leisure-cycling/italia/sardinia/sardinia-1.webp"
          alt="Fietser kijkt uit over de bergen met de fiets naast zich"
        />
        <img
          class="rounded-xl absolute md:w-[10rem] lg:w-[15em] ml-64 md:-mt-24 lg:-mt-32 grayscale-[60%] hover:grayscale-0 transition-all duration-300 ease-out hover:scale-105"
          src="/cycle-tour/leisure-cycling/italia/sardinia/sardinia-5.webp"
          alt="Fietser kijkt uit over de bergen met de fiets naast zich"
        />
      </div>

      <div class="grid gap-5 md:-mt-20">
        <div>
          <h2
            class="mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-4 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
            {i18n.PRODUCTS.LEISURE_CYCLING.CYCLE_RONDA_CORDOBA.AVAILABILITY}
          </h2>
          <p>
            Geen geschikte data in de planning gevonden? Neem contact met ons
            op en laat weten wanneer je beschikbaar bent. Voor privétours bieden
            we graag een reis op maat aan.
          </p>
          <div class="gap-4 mt-6">
            <ul class="text-lg">
              <div class="grid lg:grid-cols-2 gap-2 mt-4">
                <div class="flex gap-2">
                  <Icon icon="autumn-logo" size="1.6rem" color="#ff5e00" />
                  <p>Herfst 2026</p>
                </div>

                <div class="grid">
                  <li>14.09.26 – 23.09.26 (Volgeboekt)</li>
                  <li>25.09.26 – 04.10.26 (Volgeboekt)</li>
                </div>
              </div>
              <div class="grid lg:grid-cols-2 gap-2 mt-4">
                <div class="flex gap-2">
                  <Icon icon="spring-logo" size="1.6rem" color="#ff5e00" />
                  <p>Lente 2027</p>
                </div>

                <div class="grid">
                  <li>02.04.27 – 11.04.27</li>
                  <li>16.04.27 – 25.04.27</li>
                  <li>07.05.27 – 16.05.27</li>
                </div>
              </div>
              <div class="grid lg:grid-cols-2 gap-2 mt-4">
                <div class="flex gap-2">
                  <Icon icon="autumn-logo" size="1.6rem" color="#ff5e00" />
                  <p>Herfst 2027</p>
                </div>

                <div class="grid">
                  <li>10.09.27 – 19.09.27</li>
                  <li>24.09.27 – 03.10.27</li>
                </div>
              </div>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 mt-10 items-center">
      <div>
        <h2
          class="mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-4 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
          Fiets
        </h2>
        <p>🔶 Scott</p>
        <p>🔶 Aluminium frame</p>
        <p>🔶 Accu van 625 Ah</p>
        <p>🔶 Aangedreven door Bosch</p>
        <p>🔶 Shimano hydraulische schijfremmen en uitrusting</p>
        <p>🔶 Schwalbe-antilekbanden 700x50</p>
        <p>🔶 Gewicht: 22 kg</p>
      </div>
      <div class="w-full overflow-x-auto">
        <ol class="w-full">
          {(<SliderReact IMG={BIKES} client:visible />)}
        </ol>
      </div>
    </div>

    <AccordionProducts
      title="Reis<br />informatie"
      cycleSardiniaEs={cycleSardiniaNl}
    />

    <div class="grid lg:grid-cols-2 gap-4 items-center">
      <div>
        <h2
          class="mb-4 inline-block rounded-lg bg-[#3c5546] px-6 py-4 text-2xl font-bold text-white md:text-4xl xl:text-5xl">
          Wat neem je mee op je fietsvakantie?
        </h2>
        <p class="mb-2">
          Met een goed ingepakte tas verloopt je fietstocht een stuk soepeler!
          Dit raden we aan voor je fietstocht door Sardinië.
        </p>
        <p class="font-bold mb-2">Paklijst</p>
        <p class="font-bold">Fietskleding:</p>
        <p>
          🔶 Fietsbroek (met zeem) en fietsshirt – 2–3 sets (met lange en korte
          mouwen)
        </p>
        <p>🔶 Licht wind- en/of waterdicht jack (regenjack)</p>
        <p>🔶 Trui of fleecevest (extra laag voor koelere omstandigheden)</p>
        <p>
          🔶 Fietshandschoenen met padding (ochtenden in lente en herfst kunnen fris zijn)
        </p>
        <p>🔶 Arm- en beenwarmers (optioneel, maar erg handig)</p>
        <p class="mb-2">🔶 Sneldrogende sportsokken</p>
        <p class="font-bold">Bescherming tegen zon en weer:</p>
        <p>🔶 Zonnehoed</p>
        <p>🔶 Nekwarmer (buff)</p>
        <p>🔶 Zonnebril</p>
        <p>🔶 Fietspet of buff (beschermt tegen de zon onder de helm)</p>
        <p>🔶 Zonnebrandcrème (hoge SPF-factor)</p>
        <p class="mb-2">🔶 Lippenbalsem met SPF (aanbevolen)</p>
        <p class="font-bold">Uitrusting en accessoires:</p>
        <p>🔶 Bidon (door ons verstrekt)</p>
        <p>
          🔶 Fietshelm (door ons verstrekt). Geef aan als je een helm nodig
          hebt!
        </p>
        <p>🔶 Gelzadelhoes voor extra comfort (optioneel)</p>
        <p>🔶 Kleine rugzak</p>
        <p class="mb-2">🔶 Fietstas (door ons verstrekt)</p>
        <p class="font-bold">Schoenen en vrijetijdskleding:</p>
        <p>🔶 Comfortabele schoenen (fietsen op sandalen raden we af)</p>
        <p>🔶 Vrijetijdskleding en een extra paar schoenen voor 's avonds</p>
        <p class="mb-2">🔶 Badkleding</p>
        <p class="font-bold">Documenten en gezondheid:</p>
        <p>🔶 Paspoort</p>
        <p>🔶 Reisverzekering</p>
        <p>🔶 Persoonlijke EHBO-set</p>
        <p>🔶 Insectenwerend middel</p>
        <p class="mb-2">🔶 Persoonlijke medicatie (indien van toepassing)</p>
        <p>
          Heb je vragen over de aanbevolen uitrusting of weet je niet zeker wat
          je moet meenemen? Neem dan gerust contact met ons op.
        </p>
      </div>
      <div>
        <img
          class="rounded-2xl"
          src="/cycle-tour/leisure-cycling/italia/sardinia/sardinia-map.webp"
          alt="Kaart van de fietstocht door Sardinië"
        />
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-4 lg:mt-20 mt-10 mb-10">
      <div>
