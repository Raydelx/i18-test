---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import Sectionhead from "../../components/sectionhead.astro";
import Card from "../../components/card.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils.js";
import { getI18N } from "@/i18n/";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const HikinkTrekking = [
  {
    name: "Picos de Europa",
    description: "Comming Soon",
    href: "#",
    href_img: "/hiking-and-trekking/spain/picos-de-europa/pde-product.webp",
    alt_img: "Picos de Europa",
  },
];
---

<Layout title="Hiking & Trekking Spanje">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Hiking & Trekking Spanje</Fragment>
      <Fragment slot="desc"></Fragment>
    </Sectionhead>
    <main class="mt-32">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
        {
          HikinkTrekking.map((tour) => (
            <li class="mb-10">
              <Card {...tour} />
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
