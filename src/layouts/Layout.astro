---
import { SEO } from "astro-seo";
import "../styles/global.css";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar/navbar.astro";
import "@fontsource/lato/400.css"; // Specify weight
import "@fontsource/lato/400-italic.css"; // Specify weight and style

import { LANGUAGES, ui } from "@/i18n/ui";
import { getLangFromUrl, getLocalizedPathname } from "@/i18n/utils";

// import { getLangFromUrl } from "@/i18n/utils";

import WhatsappButton from "@/components/ui/whatsappButton.astro";

// const i18n = getI18N({ currentLocale });
// const lang = getLangFromUrl(Astro.url);

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const lang = getLangFromUrl(Astro.url);
type Locale = keyof typeof ui;
const siteURL = Astro.site ?? new URL(Astro.url.origin);

const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();

const defaultMetadata = {
  en: {
    title: "Guided Cycling, Hiking & Adventure Tours in Spain & Italy",
    description:
      "Guided cycling, hiking, road trips and tailor-made adventure holidays across Spain and Italy with Montaraz Outdoors & Culture.",
    imageAlt: "Guided outdoor adventure with Montaraz Outdoors & Culture",
  },
  nl: {
    title:
      "Begeleide fiets-, wandel- en avontuurlijke reizen in Spanje en Italie",
    description:
      "Begeleide fiets-, wandel- en avontuurlijke reizen in Spanje en Italie met Montaraz Outdoors & Culture.",
    imageAlt: "Begeleide outdoorervaring met Montaraz Outdoors & Culture",
  },
} as const;

const {
  title,
  description,
  image = "/og-home.jpg",
  imageAlt,
  structuredData,
} = Astro.props;
const localizedMetadata = defaultMetadata[lang];
const routeSegments = Astro.url.pathname.split("/").filter(Boolean);
const routeSlug = routeSegments.at(-1);
const inferredTitle =
  routeSlug && routeSlug !== lang
    ? routeSlug
        .split("-")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ")
    : undefined;
const effectiveTitle = title || inferredTitle;
const pageTitle = effectiveTitle
  ? `${effectiveTitle} | Montaraz Outdoors & Culture`
  : localizedMetadata.title;
const titleBasedDescription = effectiveTitle
  ? lang === "nl"
    ? `Ontdek ${effectiveTitle} met Montaraz Outdoors & Culture. Begeleide fiets-, wandel- en avontuurlijke reizen in Spanje en Italie.`
    : `Discover ${effectiveTitle} with Montaraz Outdoors & Culture. Guided cycling, hiking and adventure travel in Spain and Italy.`
  : localizedMetadata.description;
const pageDescription = description ?? titleBasedDescription;
const resolvedImageWithDomain = new URL(image, siteURL).toString();
const resolvedImageAlt = imageAlt ?? localizedMetadata.imageAlt;

const alternates = Object.values(LANGUAGES).map(({ code }) => ({
  lang: code,
  url: new URL(
    getLocalizedPathname(Astro.url.pathname, lang, code as Locale),
    siteURL,
  ).toString(),
}));
const defaultAlternate = alternates.find(
  (alternate) => alternate.lang === "en",
);

const organizationSchema = {
  "@type": "TravelAgency",
  "@id": new URL("/#organization", siteURL).toString(),
  name: "Montaraz Outdoors & Culture",
  url: siteURL.toString(),
  logo: new URL("/logo-new.webp", siteURL).toString(),
  image: resolvedImageWithDomain,
  email: "montarazoutdoors@gmail.com",
  telephone: "+34665311314",
  identifier: {
    "@type": "PropertyValue",
    name: "Travel agency registration",
    value: "C.IAN-188135-3",
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Andalusia" },
    { "@type": "Country", name: "Spain" },
    { "@type": "Country", name: "Italy" },
  ],
  sameAs: [
    "https://www.instagram.com/montaraz_outdoors_culture/",
    "https://www.youtube.com/@montarazoutdoors",
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": new URL("/#website", siteURL).toString(),
  name: "Montaraz Outdoors & Culture",
  url: siteURL.toString(),
  inLanguage: lang,
  publisher: { "@id": organizationSchema["@id"] },
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalURL,
  name: pageTitle,
  description: pageDescription,
  url: canonicalURL,
  inLanguage: lang,
  isPartOf: { "@id": websiteSchema["@id"] },
};

const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    webPageSchema,
    ...pageStructuredData,
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.webp" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.webp"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.webp"
    />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "Raydel Conesa Perez",
        site: "Montaraz Outdoor & Culture",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: pageTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: resolvedImageAlt,
        },
      }}
    />
    <meta property="og:locale" content={lang === "nl" ? "nl_NL" : "en_US"} />
    <meta name="twitter:image" content={resolvedImageWithDomain} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.url} />
      ))
    }
    {
      defaultAlternate && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={defaultAlternate.url}
        />
      )
    }
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <div>
      <div class="wave"></div>
      <div class="wave"></div>
      <div class="wave"></div>
    </div>
    <Navbar />

    <slot />
    <WhatsappButton />
    <div class="m-auto mt-10 grid justify-center">
      <button id="scrollToTop" class="scroll-to-top">Go top ↑</button>
    </div>

    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      body {
        margin: auto;
        font-family: lato;
        overflow: auto;
        background: linear-gradient(
          315deg,
          rgb(241, 251, 255) 3%,
          rgb(225, 228, 231) 38%,
          rgb(222, 224, 224) 68%,
          rgb(247, 239, 239) 98%
        );
        animation: gradient 15s ease infinite;
        background-size: 400% 400%;
        background-attachment: fixed;
      }

      @keyframes gradient {
        0% {
          background-position: 0% 0%;
        }
        50% {
          background-position: 100% 100%;
        }
        100% {
          background-position: 0% 0%;
        }
      }

      .wave {
        background: rgb(255 255 255 / 25%);
        border-radius: 1000% 1000% 0 0;
        position: fixed;
        width: 200%;
        height: 12em;
        animation: wave 10s -3s linear infinite;
        transform: translate3d(0, 0, 0);
        opacity: 0.8;
        bottom: 0;
        left: 0;
        z-index: -1;
      }

      .wave:nth-of-type(2) {
        bottom: -1.25em;
        animation: wave 18s linear reverse infinite;
        opacity: 0.8;
      }

      .wave:nth-of-type(3) {
        bottom: -2.5em;
        animation: wave 20s -1s reverse infinite;
        opacity: 0.9;
      }

      @keyframes wave {
        2% {
          transform: translateX(1);
        }

        25% {
          transform: translateX(-25%);
        }

        50% {
          transform: translateX(-50%);
        }

        75% {
          transform: translateX(-25%);
        }

        100% {
          transform: translateX(1);
        }
      }
      img {
        content-visibility: auto;
      }
      .scroll-to-top {
        bottom: 20px;
        right: 20px;
        display: none; /* Hidden by default */
        background-color: #ff5e00;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 10px 15px;
        font-size: 18px;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }

      .scroll-to-top:hover {
        background-color: #ff863f;
      }

      .scroll-to-top.show {
        display: block; /* Show the button when needed */
      }
    </style>
    <script is:inline>
      const scrollToTopButton = document.getElementById("scrollToTop");

      window.addEventListener("scroll", () => {
        if (window.scrollY > 300) {
          scrollToTopButton.classList.add("show");
        } else {
          scrollToTopButton.classList.remove("show");
        }
      });

      scrollToTopButton.addEventListener("click", () => {
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      });
    </script>
  </body>
</html>
